---
import { render, type CollectionEntry } from "astro:content";
import SiteLayout from "../layouts/SiteLayout.astro";
import ContentFallbackBanner from "../components/ContentFallbackBanner.astro";
import LearnQuiz from "../components/learn/LearnQuiz";
import { QUIZ_MIN_QUESTIONS } from "../components/learn/quiz-types";
import { CATEGORY_BY_ID } from "../data/learn-categories";
import { LATEX_COMMANDS } from "../data/latex-commands";
import { DEFAULT_LOCALE, type Locale } from "../i18n/locales";
import { getCategoryLabel } from "../i18n/categories";
import { entrySlug } from "../i18n/content";
import { localePath } from "../i18n/paths";
import { t } from "../i18n/t";
import "../styles/learn.css";
import "../styles/listen.css";
import "katex/dist/katex.min.css";

interface Props {
  article: CollectionEntry<"learn">;
  prev: CollectionEntry<"learn"> | null;
  next: CollectionEntry<"learn"> | null;
  locale?: Locale;
  isFallback?: boolean;
}

const {
  article,
  prev,
  next,
  locale = DEFAULT_LOCALE,
  isFallback = false,
} = Astro.props;
const { Content } = await render(article);
const cat = CATEGORY_BY_ID[article.data.category];
const catLabel = getCategoryLabel(locale, article.data.category);
const lp = (path: string) => localePath(locale, path);
const articleSlug = entrySlug(article.id);
const backToTrack = `${lp("/learn/")}#${article.data.category}`;
const levelLabel = t(locale, `common.${article.data.level}` as "common.beginner");

const GLOSSARY_CAP = 18;
const usedKeys = new Set<string>();
if (articleSlug !== "every-command-explained") {
  for (const block of article.body?.matchAll(/```(?:latex|tex)\n([\s\S]*?)```/g) ?? []) {
    for (const e of block[1].matchAll(/\\begin\{([a-zA-Z*]+)\}/g)) usedKeys.add(`env:${e[1]}`);
    for (const c of block[1].matchAll(/\\([a-zA-Z]+)/g)) {
      if (c[1] !== "begin" && c[1] !== "end") usedKeys.add(c[1]);
    }
  }
}
const glossaryAll = [...usedKeys]
  .filter((k) => LATEX_COMMANDS[k])
  .sort((a, b) => a.replace(/^env:/, "").localeCompare(b.replace(/^env:/, "")))
  .map((k) => ({
    name: k.startsWith("env:") ? `\\begin{${k.slice(4)}}` : `\\${k}`,
    desc: LATEX_COMMANDS[k],
  }));
const glossary = glossaryAll.slice(0, GLOSSARY_CAP);
const glossaryMore = glossaryAll.length - glossary.length;

const quiz =
  article.data.quiz && article.data.quiz.questions.length >= QUIZ_MIN_QUESTIONS
    ? article.data.quiz
    : null;
---

<SiteLayout
  title={t(locale, "learn.titleSuffix", { title: article.data.title })}
  description={article.data.description}
  path={`/learn/${articleSlug}/`}
  locale={locale}
>
  <article class="learn-article">
    <div class="learn-article-inner">
      <ContentFallbackBanner locale={locale} show={isFallback} />
      <nav class="learn-back" aria-label={t(locale, "common.back")}>
        <a class="learn-back-link" href={backToTrack}>
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M15 18l-6-6 6-6"></path>
          </svg>
          <span>{t(locale, "learn.backTo", { track: catLabel })}</span>
        </a>
        <a class="learn-back-all" href={lp("/learn/")}>{t(locale, "learn.allTracks")}</a>
      </nav>

      <nav class="learn-breadcrumb" aria-label={t(locale, "learn.breadcrumb")}>
        <a href={lp("/learn/")}>{t(locale, "nav.learn")}</a>
        <span class="sep">/</span>
        <a href={backToTrack}>{catLabel}</a>
        <span class="sep">/</span>
        <span>{article.data.title}</span>
      </nav>

      <h1>{article.data.title}</h1>
      <p class="lede">{article.data.description}</p>
      <div class="learn-article-meta">
        <span class:list={["learn-badge", "learn-track-pill", cat?.badge]}>{catLabel}</span>
        <span class={`learn-pill level level-${article.data.level}`}>{levelLabel}</span>
        {
          article.data.tags.slice(0, 3).map((t) => (
            <span class="learn-pill">{t}</span>
          ))
        }
        <span
          id="learn-listen-host"
          class="blog-listen"
          hidden
          data-lesson-id={article.id}
        ></span>
      </div>

      <div class="learn-prose">
        <Content />
      </div>

      {
        glossary.length > 0 && (
          <aside class="latex-glossary" aria-label={t(locale, "learn.glossaryLabel")}>
            <h3>{t(locale, "learn.glossaryLabel")}</h3>
            <p class="latex-glossary-sub">
              {t(locale, "learn.glossaryIntro", {
                link: t(locale, "learn.glossaryLink"),
              }).split(t(locale, "learn.glossaryLink"))[0]}
              <a href={lp("/learn/every-command-explained/")}>{t(locale, "learn.glossaryLink")}</a>
              {t(locale, "learn.glossaryIntro", {
                link: t(locale, "learn.glossaryLink"),
              }).split(t(locale, "learn.glossaryLink"))[1] ?? ""}
            </p>
            <dl>
              {glossary.map((g) => (
                <>
                  <dt>{g.name}</dt>
                  <dd>{g.desc}</dd>
                </>
              ))}
            </dl>
            {glossaryMore > 0 && (
              <p class="latex-glossary-sub" style="margin-top:10px;margin-bottom:0">
                {t(locale, "learn.glossaryMore", {
                  n: glossaryMore,
                  link: t(locale, "learn.glossaryFullRef"),
                }).split(t(locale, "learn.glossaryFullRef"))[0]}
                <a href={lp("/learn/every-command-explained/")}>{t(locale, "learn.glossaryFullRef")}</a>
                {t(locale, "learn.glossaryMore", {
                  n: glossaryMore,
                  link: t(locale, "learn.glossaryFullRef"),
                }).split(t(locale, "learn.glossaryFullRef"))[1] ?? ""}
              </p>
            )}
          </aside>
        )
      }

      {
        quiz && (
          <LearnQuiz
            client:visible
            title={quiz.title || t(locale, "learn.quizDefault")}
            questions={quiz.questions}
            lessonId={article.id}
          />
        )
      }

      <nav class="learn-pager" aria-label={t(locale, "learn.courseTracks")}>
        {
          prev ? (
            <a href={lp(`/learn/${entrySlug(prev.id)}/`)} class="prev">
              <div class="dir">{t(locale, "learn.prev")}</div>
              <div class="name">{prev.data.title}</div>
            </a>
          ) : (
            <a href={backToTrack} class="prev">
              <div class="dir">{t(locale, "common.back")}</div>
              <div class="name">{catLabel}</div>
            </a>
          )
        }
        {
          next ? (
            <a href={lp(`/learn/${entrySlug(next.id)}/`)} class="next">
              <div class="dir">{t(locale, "learn.next")}</div>
              <div class="name">{next.data.title}</div>
            </a>
          ) : (
            <a href={lp("/learn/")} class="next">
              <div class="dir">{t(locale, "learn.heading")}</div>
              <div class="name">{t(locale, "learn.allTracks")}</div>
            </a>
          )
        }
      </nav>

      <p class="learn-back-bottom">
        <a class="learn-back-link" href={backToTrack}>
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M15 18l-6-6 6-6"></path>
          </svg>
          <span>{t(locale, "learn.backTo", { track: catLabel })}</span>
        </a>
      </p>
    </div>
  </article>

  <script>
    // Live previews for LaTeX code snippets (shared pipeline with /live), a
    // copy button on every code block, and an "Edit live" jump into /live.
    import { SKIP, stripComments, renderLatexSnippet } from "../lib/latex-live-preview";

    const COPY_ICON =
      '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="9" y="9" width="13" height="13" rx="2"></rect><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path></svg>';
    const CHECK_ICON =
      '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"></path></svg>';

    const attachPanel = (pre: HTMLElement, body: HTMLElement, editSource: string) => {
      const panel = document.createElement("div");
      panel.className = "latex-preview";
      const head = document.createElement("div");
      head.className = "latex-preview-head";
      const label = document.createElement("span");
      label.textContent = "Rendered preview";
      head.appendChild(label);
      const edit = document.createElement("a");
      edit.href = `/live/?latex=${encodeURIComponent(editSource)}`;
      edit.textContent = "Edit live →";
      edit.title = "Open in the live LaTeX playground";
      head.appendChild(edit);
      body.classList.add("latex-preview-body");
      panel.appendChild(head);
      panel.appendChild(body);
      pre.insertAdjacentElement("afterend", panel);
    };

    for (const pre of document.querySelectorAll<HTMLElement>(".learn-prose pre")) {
      const raw = pre.textContent ?? "";

      // Copy button on every code block, whatever the language.
      const btn = document.createElement("button");
      btn.type = "button";
      btn.className = "code-copy";
      btn.setAttribute("aria-label", "Copy code");
      btn.title = "Copy to clipboard";
      btn.innerHTML = COPY_ICON;
      btn.addEventListener("click", () => {
        void navigator.clipboard.writeText(raw.replace(/\n$/, ""));
        btn.innerHTML = CHECK_ICON;
        btn.classList.add("copied");
        setTimeout(() => {
          btn.innerHTML = COPY_ICON;
          btn.classList.remove("copied");
        }, 1400);
      });
      pre.appendChild(btn);

      // Live preview panel for renderable LaTeX blocks; document-level
      // blocks get an honest note instead of silence, so every snippet on
      // every lesson page has a preview area.
      const lang = pre.dataset.language;
      if (lang !== "latex" && lang !== "tex") continue;
      const cleaned = stripComments(raw);
      if (!cleaned) continue;
      const body = SKIP.test(raw) ? null : renderLatexSnippet(cleaned);
      if (body) {
        attachPanel(pre, body, cleaned);
      } else {
        const note = document.createElement("div");
        note.className = "latex-preview latex-preview-note";
        note.innerHTML =
          '<span>Document-level LaTeX: browser preview is not supported for code that shapes the compiled document (preamble, floats, bibliographies). Copy it into the free, open-source <a href="/">Oleafly app</a> to see it build.</span>' +
          `<a href="/live/?latex=${encodeURIComponent(cleaned)}">Open in playground →</a>`;
        pre.insertAdjacentElement("afterend", note);
      }
    }

    // Listen: same client TTS as blog (Kokoro → Web Speech), sentence/word highlight.
    (async () => {
      const host = document.getElementById("learn-listen-host");
      const prose = document.querySelector(".learn-prose");
      if (!(host instanceof HTMLElement) || !(prose instanceof HTMLElement)) return;
      if (!("speechSynthesis" in window)) {
        host.remove();
        return;
      }
      try {
        const { mountBlogListen } = await import("../lib/blog-listen/mount.ts");
        mountBlogListen({
          host,
          prose,
          postId: host.dataset.lessonId || location.pathname,
          surface: "learn",
          kind: "lesson",
          separator: true,
        });
      } catch {
        host.remove();
      }
    })();
  </script>
</SiteLayout>
