  /* simulated cursor -------------------------------------------------------- */
  .hv-cursor {
    position: absolute;
    left: 0;
    top: 0;
    z-index: 50;
    opacity: 0;
    transform: translate(760px, 400px);
    transition: transform 0.6s cubic-bezier(0.25, 0.6, 0.2, 1), opacity 0.3s ease;
    will-change: transform;
  }
  .heroapp[data-cursor] .hv-cursor { opacity: 1; }
  .hv-cursor-arrow,.hv-cursor-hand { position:absolute; filter:drop-shadow(0 1px 2px rgba(0,0,0,.5)); }
  .hv-cursor-arrow { left:-5px; top:-3px; width:17px; height:17px; }
  .hv-cursor-hand { display:none; left:-9px; top:-2px; width:19px; height:19px; }
  .heroapp[data-cursor-pointer] .hv-cursor-arrow { display:none; }
  .heroapp[data-cursor-pointer] .hv-cursor-hand { display:block; }
  .hv-cursor-glow {
    position: absolute;
    left: -14px;
    top: -14px;
    width: 28px;
    height: 28px;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(255, 255, 255, 0.28), transparent 70%);
  }
  .hv-cursor-ring {
    position: absolute;
    left: -9px;
    top: -9px;
    width: 18px;
    height: 18px;
    border-radius: 50%;
    border: 2px solid rgba(96, 165, 250, 0.95);
    box-shadow: 0 0 0 2px rgba(255, 255, 255, 0.42);
    opacity: 0;
    transform: scale(0.4);
  }
  .hv-cursor-ring.is-click { animation: hv-ring 0.85s ease-out; }
  @keyframes hv-ring {
    0% { opacity: 1; transform: scale(0.3); }
    58% { opacity: 0.72; }
    100% { opacity: 0; transform: scale(1.85); }
  }

  @keyframes hv-rotate { to { transform: rotate(360deg); } }

