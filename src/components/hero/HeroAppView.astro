---
// Animated HTML replica of the Oleafly desktop app for the landing hero.
// Everything is real markup — no screenshots, no video. The window is a fixed
// 1080×678 stage (the app at 1524px logical width × 0.7087) scaled with CSS
// zoom, so proportions always match the desktop app. Geometry and colors come
// from oleafly-desktop (globals.css + component classes, logical px × 0.7087):
// toolbar h-12→34, rail w-12→34, sidebar 340→241, editor 13px/1.6 → 9.2/14.75,
// tokens: bg #0a0a0a, panel #171717, popover #121212, hover surface #181818,
// primary #2563eb, GitHub-dark editor palette.
//
// The Project View tab plays a scripted tour with a simulated cursor:
// compile → PDF render → source tree → resize → scroll + hover diagnostics →
// enable auto compile → fix the reference → live recompile → export as PDF.
// The other tabs are faithful stills of the same project, each ready to grow
// its own flow.
import { t } from "../../i18n/t";
import type { Locale } from "../../i18n/locales";
import { ic, github, leaf, iconBtn } from "./hero-icons";
import { projectScene, assistantScene, diagramScene, citeScene, homeScene } from "./hero-scenes";
import avatar from "./avatar.png";

interface Props {
  locale?: Locale;
}
const { locale } = Astro.props;

const scenes = [
  { id: "project", label: t(locale, "landing.tour.project") },
  { id: "assistant", label: t(locale, "landing.tour.assistant") },
  { id: "cite", label: t(locale, "landing.tour.citations") },
  { id: "diagram", label: t(locale, "landing.tour.diagramTool") },
  { id: "home", label: t(locale, "landing.tour.home") },
];

/* ------------------------------------------------------- compile dropdown */
const radio = (label: string, opts: { on?: boolean; suffix?: string; id?: string } = {}) =>
  `<div class="hv-mrow hv-mradio${opts.on ? " is-on" : ""}"${opts.id ? ` id="${opts.id}"` : ""}><span class="hv-mdot"></span>${label}${opts.suffix ? `<span class="hv-msuf">${opts.suffix}</span>` : ""}</div>`;

const compileMenu = `
<div class="hv-menu hv-menu-compile">
  <div class="hv-mlabel">Auto compile</div>
  ${radio("On", { id: "hvAcOn" })}
  ${radio("Off", { on: true, id: "hvAcOff" })}
  <div class="hv-msep"></div>
  <div class="hv-mlabel">Compile mode</div>
  ${radio("Normal", { on: true })}
  ${radio("Fast", { suffix: "[draft]" })}
  <div class="hv-msep"></div>
  <div class="hv-mlabel">Syntax checks</div>
  ${radio("Check syntax before compile", { on: true })}
  ${radio("Don't check syntax")}
  <div class="hv-msep"></div>
  <div class="hv-mlabel">Compiler (this project)<span class="hv-minfo">${ic.info}</span></div>
  ${radio("Tectonic", { on: true, suffix: "[built in]" })}
  ${radio("Auto", { suffix: "[system TeX]" })}
  ${radio("pdfLaTeX", { suffix: "[system TeX]" })}
  ${radio("XeLaTeX", { suffix: "[system TeX]" })}
  ${radio("LuaLaTeX", { suffix: "[system TeX]" })}
  <div class="hv-msep"></div>
  <div class="hv-mlabel">Compile error handling</div>
  ${radio("Stop on first error")}
  ${radio("Try to compile despite errors", { on: true })}
  <div class="hv-msep"></div>
  <div class="hv-mrow is-disabled">Stop compilation</div>
  <div class="hv-mrow">Recompile from scratch</div>
</div>`;

/* -------------------------------------------------------- export dropdown */
const mItem = (icon: string, label: string, id = "") =>
  `<div class="hv-mrow hv-mitem"${id ? ` id="${id}"` : ""}><span class="hv-mic">${icon}</span>${label}</div>`;

const exportMenu = `
<div class="hv-menu hv-menu-export">
  ${mItem(ic.fileArchive, "Export source (.zip)")}
  ${mItem(ic.fileText, "Export as PDF", "hvExportPdf")}
  <div class="hv-msep"></div>
  ${mItem(ic.fileType, "Export as Word (.docx)")}
  ${mItem(ic.fileType, "Export as HTML (.html)")}
  ${mItem(ic.fileType, "Export as Markdown (.md)")}
  ${mItem(ic.fileType, "Export as Plain text (.txt)")}
</div>`;
---

<div class="heroapp" data-heroapp data-scene="project">
  <div class="hv-tour" role="tablist" aria-label={t(locale, "landing.tour.group")}>
    <div class="hv-tour-in">
      {
        scenes.map((s, i) => (
          <button
            class="hv-tourbtn"
            type="button"
            role="tab"
            data-goto={s.id}
            aria-selected={i === 0 ? "true" : "false"}
          >
            {s.label}
          </button>
        ))
      }
      <span class="hv-tour-prog" aria-hidden="true"><span id="hvProg"></span></span>
    </div>
  </div>

  <figure class="hv-frame" role="presentation">
    <div class="hv-viewport">
      <div class="hv-stage" aria-hidden="true">
        <!-- ============================== top toolbar ============================== -->
        <header class="hv-top">
          <div class="hv-top-left">
            <span class="hv-brand"><Fragment set:html={leaf} /><span>Oleafly</span></span>
            <span class="hv-top-sep"><Fragment set:html={ic.chevR} /></span>
            <span class="hv-proj"><span class="hv-proj-dot"></span>EdgeSense: Energy Aware Wi&hellip;</span>
          </div>
          <div class="hv-seg">
            <span class="hv-seg-btn" id="hvSegEdit"><Fragment set:html={ic.squarePen} /></span>
            <span class="hv-seg-btn is-on" id="hvSegSplit"><Fragment set:html={ic.columns2} /></span>
            <span class="hv-seg-btn" id="hvSegPdf"><Fragment set:html={ic.fileText} /></span>
          </div>
          <div class="hv-top-right">
            <span class="hv-compile" id="hvCompile">
              <span class="hv-cp-main">
                <span class="hv-cp-spin"></span>
                <span class="hv-cp-re"><Fragment set:html={ic.refresh} /></span>
                <span class="hv-cp-label" id="hvCpLabel">Compile</span>
              </span>
              <span class="hv-cp-chev" id="hvCpChev"><Fragment set:html={ic.chevD} /></span>
            </span>
            <span class="hv-ib" id="hvExportBtn"><Fragment set:html={ic.download} /></span>
            <span class="hv-ib"><Fragment set:html={ic.history} /></span>
            <span class="hv-ib"><Fragment set:html={ic.fork} /></span>
            <span class="hv-tdiv"></span>
            <span class="hv-gh"><img class="hv-avatar-img" src={avatar.src} alt="" width="14" height="14" /><span class="hv-gh-name">prajwal-svm</span></span>
            <span class="hv-ib"><Fragment set:html={ic.keyboard} /></span>
            <span class="hv-ib"><Fragment set:html={ic.layoutGrid} /></span>
          </div>
          <Fragment set:html={compileMenu} />
          <Fragment set:html={exportMenu} />
        </header>

        <div class="hv-body">
          <!-- ============================== activity rail ============================== -->
          <nav class="hv-rail">
            <span class="hv-railbtn is-active" id="hvRailFiles"><Fragment set:html={ic.fileText} /></span>
            <span class="hv-railbtn"><Fragment set:html={ic.search} /></span>
            <span class="hv-railbtn"><Fragment set:html={ic.gitBranch} /></span>
            <span class="hv-rsep"></span>
            <span class="hv-railbtn"><Fragment set:html={ic.shieldCheck} /></span>
            <span class="hv-railbtn"><Fragment set:html={ic.searchCode} /></span>
            <span class="hv-rsep"></span>
            <span class="hv-railbtn" id="hvRailAssistant"><Fragment set:html={ic.sparkles} /></span>
            <span class="hv-rail-spacer"></span>
            <span class="hv-railbtn"><Fragment set:html={ic.panelLeft} /></span>
            <span class="hv-railbtn"><Fragment set:html={ic.help} /></span>
            <span class="hv-railbtn"><Fragment set:html={ic.sun} /></span>
            <span class="hv-railbtn"><Fragment set:html={ic.gear} /></span>
          </nav>

          <Fragment set:html={projectScene} />
          <Fragment set:html={assistantScene} />
          <Fragment set:html={diagramScene} />
          <Fragment set:html={citeScene} />
          <Fragment set:html={homeScene} />
        </div>

        <!-- toast + simulated cursor -->
        <div class="hv-toast"><span class="hv-toast-ic"><Fragment set:html={ic.checkCircle} /></span><span>Exported <b>EdgeSense.pdf</b></span></div>
        <div class="hv-cursor" id="hvCursor">
          <span class="hv-cursor-glow"></span>
          <span class="hv-cursor-ring" id="hvRing"></span>
          <svg class="hv-cursor-arrow" viewBox="0 0 24 24" aria-hidden="true">
            <path d="M5.5 3.2 19 12.1l-6.2 1.2 3 6.3-2.7 1.2-3-6.4-4.6 4.1z" fill="#fff" stroke="#1b1b1b" stroke-width="1.5" stroke-linejoin="round"/>
          </svg>
          <svg class="hv-cursor-hand" viewBox="0 0 24 24" aria-hidden="true">
            <path d="M9.5 11V5.5a1.7 1.7 0 0 1 3.4 0V10 4.4a1.7 1.7 0 0 1 3.4 0V10 6.2a1.7 1.7 0 0 1 3.4 0v6.5c0 4.5-2.7 7.3-6.7 7.3h-1.2c-2.4 0-3.7-1.1-4.9-3L4.8 13.4a1.8 1.8 0 0 1 3.1-1.8l1.6 2.3z" fill="#fff" stroke="#1b1b1b" stroke-width="1.35" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </div>
      </div>
    </div>
  </figure>
</div>

<style is:global>
  /* Global (not scoped): most panes are frontmatter-built strings injected via
     set:html, which Astro's scoping can't attribute. Every class is hv-prefixed. */
  .heroapp {
    --hv-bg: #0a0a0a;
    --hv-panel: #171717;
    --hv-rail: #131313;
    --hv-elev: #262626;
    --hv-pop: #121212;
    --hv-pop2: #181818;
    --hv-line: rgba(255, 255, 255, 0.1);
    --hv-line-soft: rgba(255, 255, 255, 0.07);
    --hv-fg: #fafafa;
    --hv-mut: #a1a1a1;
    --hv-mut2: #6e6e6e;
    --hv-blue: #2563eb;
    --hv-run: #3b82f6;
    --hv-emerald: #10b981;
    --hv-amber: #f59e0b;
    --hv-red: #ef4444;
    --hv-font: "Geist", var(--font, "Inter"), ui-sans-serif, system-ui, sans-serif;
    --hv-mono: "Geist Mono", var(--mono, "JetBrains Mono"), ui-monospace, monospace;
    width: min(1280px, calc(100vw - 48px));
    margin-left: 50%;
    transform: translateX(-50%);
  }
  .heroapp,
  .heroapp * {
    box-sizing: border-box;
    scrollbar-width: none;
  }
  .heroapp *::-webkit-scrollbar {
    display: none;
  }

  /* tour bar --------------------------------------------------------------- */
  .hv-tour {
    display: flex;
    justify-content: center;
    margin: 0 auto 16px;
  }
  .hv-tour-in {
    position: relative;
    display: flex;
    isolation: isolate;
    gap: 3px;
    padding: 6px 7px 8px;
    border: 1px solid rgba(255, 255, 255, 0.105);
    border-radius: 999px;
    background:
      linear-gradient(180deg, rgba(255, 255, 255, 0.035), rgba(255, 255, 255, 0.008)),
      rgba(5, 7, 9, 0.28);
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.09),
      inset 0 -1px 0 rgba(255, 255, 255, 0.025),
      0 14px 38px rgba(0, 0, 0, 0.24),
      0 2px 8px rgba(0, 0, 0, 0.24);
    -webkit-backdrop-filter: blur(12px) saturate(185%) contrast(108%);
    backdrop-filter: blur(12px) saturate(185%) contrast(108%);
    overflow: hidden;
  }
  .hv-tour-in::before {
    content: "";
    position: absolute;
    z-index: -1;
    inset: 1px;
    border-radius: inherit;
    background:
      radial-gradient(58% 150% at 9% -70%, rgba(255, 255, 255, 0.09), transparent 55%),
      radial-gradient(42% 140% at 92% 170%, rgba(74, 143, 255, 0.045), transparent 68%);
    pointer-events: none;
  }
  .hv-tourbtn {
    appearance: none;
    position: relative;
    z-index: 1;
    border: 1px solid transparent;
    border-radius: 999px;
    padding: 7px 15px;
    font-family: inherit;
    font-size: 12.5px;
    font-weight: 520;
    letter-spacing: 0.01em;
    color: rgba(222, 226, 234, 0.66);
    background: transparent;
    cursor: pointer;
    text-shadow: 0 1px 1px rgba(0, 0, 0, 0.42);
    transition:
      color 180ms cubic-bezier(0.22, 1, 0.36, 1),
      background 180ms cubic-bezier(0.22, 1, 0.36, 1),
      border-color 180ms cubic-bezier(0.22, 1, 0.36, 1),
      box-shadow 180ms cubic-bezier(0.22, 1, 0.36, 1),
      transform 120ms cubic-bezier(0.22, 1, 0.36, 1);
    white-space: nowrap;
  }
  .hv-tourbtn:hover {
    color: #f7f8f8;
    background: rgba(255, 255, 255, 0.035);
    border-color: rgba(255, 255, 255, 0.05);
  }
  .hv-tourbtn:active {
    transform: scale(0.975);
  }
  .hv-tourbtn:focus-visible {
    outline: 2px solid rgba(120, 181, 255, 0.82);
    outline-offset: 2px;
  }
  .hv-tourbtn[aria-selected="true"] {
    color: rgba(255, 255, 255, 0.98);
    border-color: rgba(255, 255, 255, 0.105);
    background:
      radial-gradient(110% 190% at 14% -75%, rgba(255, 255, 255, 0.075), transparent 49%),
      linear-gradient(118deg, rgba(255, 255, 255, 0.022), rgba(255, 255, 255, 0.006) 48%, rgba(126, 177, 255, 0.028)),
      rgba(8, 10, 13, 0.22);
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.105),
      inset 1px 0 0 rgba(255, 255, 255, 0.045),
      inset -1px 0 0 rgba(122, 177, 255, 0.04),
      inset 0 -1px 0 rgba(0, 0, 0, 0.22),
      0 7px 18px rgba(0, 0, 0, 0.2);
    -webkit-backdrop-filter: blur(11px) saturate(195%) brightness(108%);
    backdrop-filter: blur(11px) saturate(195%) brightness(108%);
  }
  .hv-tour-prog {
    position: absolute;
    left: 14px;
    right: 14px;
    bottom: 0;
    height: 2px;
    border-radius: 2px;
    background: rgba(255, 255, 255, 0.08);
  }
  .hv-tour-prog span {
    display: block;
    height: 100%;
    width: 0%;
    border-radius: 2px;
    background: rgba(255, 255, 255, 0.82);
    box-shadow: 0 0 10px rgba(255, 255, 255, 0.2);
  }

  /* stage ------------------------------------------------------------------ */
  .hv-frame {
    position: relative;
    margin: 0;
    border-radius: 10px;
    overflow: hidden;
    border: 1px solid rgba(255, 255, 255, 0.15);
    background: var(--hv-bg);
    box-shadow:
      0 0 0 5px rgba(3, 4, 5, 0.86),
      0 0 0 7px rgba(255, 255, 255, 0.055),
      0 28px 72px rgba(0, 0, 0, 0.62);
  }
  .hv-frame::after {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: inherit;
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.08);
    pointer-events: none;
    z-index: 60;
  }
  .hv-viewport {
    position: relative;
    aspect-ratio: 1080 / 678;
    overflow: hidden;
    background: var(--hv-bg);
  }
  .hv-stage {
    position: absolute;
    top: 0;
    left: 0;
    width: 1080px;
    height: 678px;
    display: flex;
    flex-direction: column;
    font-family: var(--hv-font);
    color: var(--hv-fg);
    background: var(--hv-bg);
    -webkit-font-smoothing: antialiased;
    pointer-events: none;
    user-select: none;
  }

  /* shared bits ------------------------------------------------------------ */
  .hv-ib,
  .hv-ib-s,
  .hv-ib-xs {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: 4px;
    color: var(--hv-mut);
    flex-shrink: 0;
  }
  .hv-ib { width: 25px; height: 25px; }
  .hv-ib svg { width: 11.5px; height: 11.5px; }
  .hv-ib-s { width: 19px; height: 19px; }
  .hv-ib-s svg { width: 10px; height: 10px; }
  .hv-ib-xs { width: 18px; height: 18px; }
  .hv-ib-xs svg { width: 10px; height: 10px; }
  .hv-div {
    width: 1px;
    height: 11px;
    margin: 0 2.5px;
    background: var(--hv-line);
    flex-shrink: 0;
  }
  .hv-tdiv {
    width: 1px;
    height: 14px;
    margin: 0 3px;
    background: var(--hv-line);
    flex-shrink: 0;
  }

  /* top toolbar ------------------------------------------------------------ */
  .hv-top {
    position: relative;
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    height: 34px;
    padding: 0 8px 0 10px;
    border-bottom: 1px solid var(--hv-line-soft);
    background: var(--hv-bg);
    z-index: 5;
    flex-shrink: 0;
  }
  .hv-top-left {
    display: flex;
    align-items: center;
    gap: 4px;
    min-width: 0;
  }
  .hv-brand {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    font-size: 10px;
    font-weight: 600;
    letter-spacing: -0.01em;
    color: var(--hv-fg);
  }
  .hv-brand svg { width: 14px; height: 14px; }
  .hv-top-sep { color: rgba(161, 161, 161, 0.5); display: inline-flex; }
  .hv-top-sep svg { width: 10px; height: 10px; }
  .hv-proj {
    display: inline-flex;
    align-items: center;
    gap: 4.5px;
    font-size: 10px;
    color: var(--hv-mut);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .hv-proj-dot { width: 5.5px; height: 5.5px; border-radius: 50%; background: #e2543e; flex-shrink: 0; }
  .hv-seg {
    display: flex;
    align-items: center;
    padding: 1.5px;
    border: 1px solid var(--hv-line);
    border-radius: 6px;
    background: rgba(38, 38, 38, 0.4);
  }
  .hv-seg-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    height: 20px;
    padding: 0 8px;
    border-radius: 4.5px;
    color: var(--hv-mut);
  }
  .hv-seg-btn svg { width: 11.5px; height: 11.5px; }
  .hv-seg-btn.is-on {
    background: var(--hv-elev);
    color: var(--hv-fg);
    box-shadow: 0 1px 2px rgba(0, 0, 0, 0.35);
  }
  .hv-top-right {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 1px;
  }

  .hv-compile {
    display: inline-flex;
    align-items: stretch;
    height: 20px;
    border-radius: 4.5px;
    overflow: hidden;
    box-shadow: 0 1px 2px rgba(0, 0, 0, 0.35);
    margin-right: 3px;
  }
  .hv-cp-main {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    padding: 0 8px;
    background: var(--hv-blue);
    font-size: 8.5px;
    font-weight: 500;
    color: #fff;
  }
  .hv-cp-main svg { width: 9.5px; height: 9.5px; }
  .hv-cp-chev {
    display: inline-flex;
    align-items: center;
    padding: 0 4px;
    border-left: 1px solid rgba(255, 255, 255, 0.25);
    background: var(--hv-blue);
  }
  .hv-cp-chev svg { width: 9.5px; height: 9.5px; color: #fff; }
  .hv-cp-spin {
    display: none;
    width: 9px;
    height: 9px;
    border-radius: 50%;
    border: 1.3px solid rgba(255, 255, 255, 0.35);
    border-top-color: #fff;
    animation: hv-rotate 0.8s linear infinite;
  }
  /* compiling (boot or auto recompile): dim the main half, show the spinner.
     Scoped to the real top-bar button so scene-local Compile buttons stay put. */
  .heroapp[data-scene="project"]:not([data-compiled]) #hvCompile .hv-cp-main,
  .heroapp[data-recompiling] #hvCompile .hv-cp-main,
  .heroapp[data-ai-compiling] #hvCompile .hv-cp-main { opacity: 0.55; }
  .heroapp[data-scene="project"]:not([data-compiled]) #hvCompile .hv-cp-spin,
  .heroapp[data-recompiling] #hvCompile .hv-cp-spin,
  .heroapp[data-ai-compiling] #hvCompile .hv-cp-spin { display: inline-block; }
  .heroapp[data-scene="project"]:not([data-compiled]) #hvCompile .hv-cp-re,
  .heroapp[data-recompiling] #hvCompile .hv-cp-re,
  .heroapp[data-ai-compiling] #hvCompile .hv-cp-re { display: none; }
  .hv-cp-re { display: inline-flex; }

  .hv-gh {
    display: inline-flex;
    align-items: center;
    gap: 4.5px;
    height: 25px;
    padding: 0 6px 0 3px;
    border-radius: 4.5px;
  }
  .hv-avatar-img {
    width: 14px;
    height: 14px;
    border-radius: 50%;
    object-fit: cover;
    display: block;
    flex-shrink: 0;
  }
  .hv-gh-name { font-size: 8.5px; font-weight: 500; color: var(--hv-fg); }

  /* dropdown menus --------------------------------------------------------- */
  .hv-menu {
    display: none;
    position: absolute;
    top: 32px;
    z-index: 30;
    border: 1px solid var(--hv-line);
    border-radius: 5px;
    background: var(--hv-pop);
    box-shadow: 0 14px 40px rgba(0, 0, 0, 0.6);
    padding: 3px;
  }
  .hv-menu-compile { right: 216px; width: 182px; }
  .hv-menu-export { right: 174px; width: 170px; }
  .heroapp[data-pop="compile"] .hv-menu-compile { display: block; }
  .heroapp[data-pop="export"] .hv-menu-export { display: block; }
  .hv-mlabel {
    display: flex;
    align-items: center;
    gap: 4px;
    padding: 4px 6px 3px;
    font-size: 8.5px;
    font-weight: 500;
    color: var(--hv-mut);
  }
  .hv-minfo { display: inline-flex; }
  .hv-minfo svg { width: 8px; height: 8px; color: rgba(161, 161, 161, 0.6); }
  .hv-mrow {
    position: relative;
    display: flex;
    align-items: center;
    padding: 4px 6px;
    border-radius: 3px;
    font-size: 9.5px;
    color: var(--hv-fg);
    white-space: nowrap;
  }
  .hv-mradio { padding-left: 21px; }
  .hv-mdot {
    position: absolute;
    left: 7px;
    top: 50%;
    transform: translateY(-50%);
    width: 5.5px;
    height: 5.5px;
    border-radius: 50%;
    background: var(--hv-blue);
    opacity: 0;
  }
  .hv-mradio.is-on .hv-mdot { opacity: 1; }
  /* auto compile flips during the tour */
  .heroapp[data-autocompile] #hvAcOn .hv-mdot { opacity: 1; }
  .heroapp[data-autocompile] #hvAcOff .hv-mdot { opacity: 0; }
  .hv-msuf { margin-left: 4px; color: var(--hv-mut); }
  .hv-msep { height: 1px; background: var(--hv-line-soft); margin: 3px 1px; }
  .hv-mrow.is-disabled { opacity: 0.4; }
  .hv-mitem { gap: 6px; }
  .hv-mic { display: inline-flex; flex-shrink: 0; }
  .hv-mic svg { width: 10.5px; height: 10.5px; color: var(--hv-mut); }
  .hv-mrow.is-hover { background: var(--hv-elev); }

  /* activity rail ---------------------------------------------------------- */
  .hv-body {
    position: relative;
    display: flex;
    min-height: 0;
    flex: 1;
  }
  .hv-rail {
    display: flex;
    flex-direction: column;
    align-items: center;
    width: 34px;
    padding: 6px 0;
    gap: 3px;
    border-right: 1px solid var(--hv-line-soft);
    background: var(--hv-rail);
    flex-shrink: 0;
  }
  .hv-railbtn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 25px;
    height: 25px;
    border-radius: 4.5px;
    color: var(--hv-mut);
  }
  .hv-railbtn svg { width: 13.5px; height: 13.5px; }
  .hv-railbtn.is-active {
    background: rgba(37, 99, 235, 0.1);
    color: var(--hv-fg);
  }
  .hv-rsep { width: 17px; height: 1px; margin: 3px 0; background: var(--hv-line); }
  .hv-rail-spacer { flex: 1; }

  /* scenes ----------------------------------------------------------------- */
  .hv-scene {
    display: none;
    flex: 1;
    min-width: 0;
    min-height: 0;
    position: relative;
  }
  .heroapp[data-scene="project"] .hv-scene[data-scene="project"],
  .heroapp[data-scene="assistant"] .hv-scene[data-scene="assistant"],
  .heroapp[data-scene="diagram"] .hv-scene[data-scene="diagram"],
  .heroapp[data-scene="cite"] .hv-scene[data-scene="cite"],
  .heroapp[data-scene="home"] .hv-scene[data-scene="home"] {
    display: flex;
    animation: hv-scene-in 0.4s cubic-bezier(0.2, 0.7, 0.3, 1);
  }
  .hv-fullbleed {
    /* covers the whole window, top toolbar included */
    position: absolute;
    inset: -34px 0 0 0;
    z-index: 6;
    background: var(--hv-bg);
    flex-direction: column;
  }
  @keyframes hv-scene-in {
    from { opacity: 0; transform: translateY(4px); }
    to { opacity: 1; transform: none; }
  }

  /* source tree ------------------------------------------------------------ */
  .hv-tree {
    /* width is JS-animated via --treew (open/close and the drag-resize beat) */
    width: calc(var(--treew, 0) * 1px);
    min-width: 0;
    overflow: hidden;
    background: var(--hv-panel);
    border-right: 0 solid var(--hv-line-soft);
    flex-shrink: 0;
  }
  .heroapp[data-tree] .hv-tree { border-right-width: 1px; }
  .hv-tree-in {
    display: flex;
    flex-direction: column;
    width: calc(var(--treeinw, 241) * 1px);
    height: 100%;
  }
  /* tree | editor resize handle */
  .hv-tsplit {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 7px;
    flex-shrink: 0;
  }
  .heroapp:not([data-tree]) .hv-tsplit { display: none; }
  .hv-panel-head {
    display: flex;
    align-items: center;
    gap: 5px;
    height: 25.5px;
    padding: 0 8px;
    border-bottom: 1px solid var(--hv-line-soft);
    flex-shrink: 0;
  }
  .hv-ph-ic { display: inline-flex; color: var(--hv-mut); }
  .hv-ph-ic svg { width: 10px; height: 10px; }
  .hv-ph-label {
    flex: 1;
    font-size: 8.5px;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.03em;
    color: rgba(250, 250, 250, 0.7);
    white-space: nowrap;
    overflow: hidden;
  }
  .hv-ph-actions { display: inline-flex; gap: 1px; margin-left: auto; }
  .hv-tree-files { padding: 4px 5px; }
  .hv-trow {
    display: flex;
    align-items: center;
    gap: 4px;
    height: 22px;
    padding: 0 5px 0 4px;
    border-radius: 4.5px;
    font-size: 9.5px;
    color: var(--hv-fg);
    white-space: nowrap;
  }
  .hv-trow.is-active { background: var(--hv-elev); }
  .hv-star-slot { width: 10px; flex-shrink: 0; }
  .hv-star { display: inline-flex; width: 10px; color: var(--hv-fg); flex-shrink: 0; }
  .hv-star svg { width: 8.5px; height: 8.5px; }
  .hv-fic { display: inline-flex; flex-shrink: 0; }
  .hv-fic svg { width: 11px; height: 11px; }
  .hv-trow-name { overflow: hidden; text-overflow: ellipsis; }
  .hv-tree-grip {
    display: flex;
    align-items: center;
    justify-content: center;
    height: 10px;
    margin-top: auto;
    flex-shrink: 0;
  }
  .hv-tree-grip span { width: 18px; height: 2.5px; border-radius: 999px; background: var(--hv-line); }

  .hv-structure {
    display: flex;
    flex-direction: column;
    height: calc(var(--structh, 240) * 1px);
    border-top: 1px solid var(--hv-line-soft);
    flex-shrink: 0;
  }
  .hv-struct-head {
    display: flex;
    align-items: center;
    gap: 4.5px;
    height: 23px;
    padding: 0 7px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.05);
    flex-shrink: 0;
  }
  .hv-ph-label2 {
    font-size: 8px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: rgba(250, 250, 250, 0.75);
  }
  .hv-schev { display: inline-flex; color: var(--hv-mut); flex-shrink: 0; }
  .hv-schev svg { width: 8.5px; height: 8.5px; }
  .hv-count {
    margin-left: auto;
    padding: 0 3px;
    border-radius: 2px;
    background: var(--hv-elev);
    font-family: var(--hv-mono);
    font-size: 6.5px;
    line-height: 11px;
    color: var(--hv-mut);
  }
  .hv-filter {
    display: flex;
    align-items: center;
    gap: 4.5px;
    height: 20px;
    margin: 5px 6px;
    padding: 0 6px;
    border: 1px solid rgba(255, 255, 255, 0.15);
    border-radius: 4.5px;
    background: rgba(10, 10, 10, 0.7);
    font-size: 8.5px;
    color: rgba(161, 161, 161, 0.75);
    flex-shrink: 0;
  }
  .hv-filter svg { width: 9px; height: 9px; color: var(--hv-mut); }
  .hv-struct-rows { padding: 1px 5px; overflow: hidden; }
  .hv-srow {
    display: flex;
    align-items: center;
    gap: 4.5px;
    min-height: 20px;
    padding: 0 5px 0 4px;
    border-radius: 3.5px;
    font-size: 9.2px;
    color: var(--hv-fg);
    white-space: nowrap;
  }
  .hv-srow.ind { padding-left: 14px; }
  .hv-srow.ind2 { padding-left: 24px; }
  .hv-sbullet { display: inline-flex; color: rgba(161, 161, 161, 0.45); flex-shrink: 0; margin: 0 0.5px; }
  .hv-sbullet svg { width: 7.5px; height: 7.5px; }
  .hv-sic { display: inline-flex; color: var(--hv-mut); flex-shrink: 0; }
  .hv-sic svg { width: 9.5px; height: 9.5px; }
  .hv-srow-name { overflow: hidden; text-overflow: ellipsis; }
  .hv-prov {
    margin-left: auto;
    font-family: var(--hv-mono);
    font-size: 6.5px;
    color: rgba(161, 161, 161, 0.8);
    flex-shrink: 0;
  }

  /* editor ----------------------------------------------------------------- */
  .hv-editor {
    display: flex;
    flex-direction: column;
    flex: 1;
    min-width: 0;
    background: var(--hv-bg);
    position: relative;
  }
  .hv-tabs {
    display: flex;
    align-items: center;
    gap: 2px;
    height: 25px;
    padding: 0 5px;
    border-bottom: 1px solid var(--hv-line-soft);
    flex-shrink: 0;
  }
  .hv-tab {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    height: 20px;
    padding: 0 8px;
    border-radius: 4.5px;
    font-size: 9px;
    color: var(--hv-fg);
    background: #1c1c1c;
    white-space: nowrap;
  }
  .hv-tab-x { display: inline-flex; color: var(--hv-mut); }
  .hv-tab-x svg { width: 8px; height: 8px; }
  .hv-etb {
    display: flex;
    align-items: center;
    gap: 1px;
    height: 25px;
    padding: 0 5px;
    border-bottom: 1px solid var(--hv-line-soft);
    flex-shrink: 0;
  }
  .hv-etb .hv-div { height: 9px; margin: 0 2px; }
  .hv-etb-type { width: auto; padding: 0 3px; gap: 1px; }
  .hv-etb-type svg:last-child { width: 7px; height: 7px; }
  .hv-etb-right { display: flex; align-items: center; gap: 1px; margin-left: auto; }

  .hv-code {
    flex: 1;
    min-height: 0;
    padding: 7px 0;
    font-family: var(--hv-mono);
    font-size: 9.2px;
    line-height: 14.75px;
    overflow: hidden;
    position: relative;
  }
  .hv-codein { transition: transform 0.6s cubic-bezier(0.3, 0.7, 0.3, 1); }
  .hv-cl { display: flex; align-items: flex-start; min-width: 0; }
  .hv-cl.is-active { background: rgba(38, 38, 38, 0.45); }
  .hv-ln {
    flex-shrink: 0;
    width: 24px;
    text-align: right;
    color: #757575;
    font-size: 9.2px;
  }
  .hv-cl.is-active .hv-ln { color: var(--hv-fg); }
  .hv-mark {
    flex-shrink: 0;
    width: 15px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    height: 14.75px;
    color: var(--hv-mut2);
  }
  .hv-mark svg { width: 9px; height: 9px; }
  .hv-mark-fold svg { width: 8.5px; height: 8.5px; }
  .heroapp[data-fixed] .hv-mark-err { visibility: hidden; }
  .hv-ct {
    flex: 1;
    min-width: 0;
    padding-right: 10px;
    white-space: pre-wrap;
    overflow-wrap: break-word;
    color: #ececec;
  }
  .t-cmd { color: #ff7b72; }
  .t-br { color: #d2a8ff; }
  .t-env { color: #7ee787; }
  .t-key { color: #79c0ff; }
  .t-num { color: #79c0ff; }
  .hv-ct .t-key { text-decoration: underline; text-underline-offset: 2px; text-decoration-thickness: 0.8px; }
  .t-sp {
    text-decoration-line: underline;
    text-decoration-style: wavy;
    text-decoration-color: rgba(217, 119, 6, 0.82);
    text-decoration-thickness: 0.8px;
    text-underline-offset: 2.5px;
  }
  .hv-editkey.is-selected { background: rgba(37, 99, 235, 0.35); border-radius: 1px; }
  .hv-type-caret {
    display: none;
    width: 1.2px;
    height: 10px;
    margin-left: 0.5px;
    vertical-align: text-bottom;
    background: var(--hv-blue);
  }
  .hv-type-caret.is-typing {
    display: inline-block;
    animation: hv-blink 1s steps(1) infinite;
  }
  @keyframes hv-blink { 50% { opacity: 0; } }

  /* editor scrollbar (follows the tour's scroll) */
  .hv-sb {
    position: absolute;
    top: 4px;
    right: 2px;
    width: 4px;
    height: 40%;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.14);
    transition: transform 0.6s cubic-bezier(0.3, 0.7, 0.3, 1);
  }

  /* splitter --------------------------------------------------------------- */
  .hv-vsplit {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 9px;
    flex-shrink: 0;
  }
  .hv-vthumb {
    width: 2.5px;
    height: 28px;
    border-radius: 999px;
    background: var(--hv-line);
    transition: background 0.15s ease;
  }
  .heroapp[data-dragging="tree"] .hv-tsplit .hv-vthumb,
  .heroapp[data-dragging="pdf"] .hv-vsplit .hv-vthumb { background: #737373; }
  .heroapp[data-dragging="grip"] .hv-tree-grip span { background: #737373; }

  /* preview pane ----------------------------------------------------------- */
  .hv-preview {
    position: relative;
    display: flex;
    flex-direction: column;
    width: calc(var(--pvw, 517) * 1px);
    min-width: 0;
    background: var(--hv-bg);
    flex-shrink: 0;
  }
  .hv-preview-static { flex-shrink: 1; flex: 1.15; }
  .hv-pv-bar {
    display: flex;
    align-items: center;
    gap: 4px;
    min-height: 28px;
    padding: 2px 6px;
    border-bottom: 1px solid var(--hv-line-soft);
    flex-shrink: 0;
  }
  .hv-logs {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    height: 17px;
    padding: 0 6px;
    border-radius: 4px;
    font-size: 8.5px;
    font-weight: 500;
    color: var(--hv-mut);
  }
  .hv-logs svg { width: 10px; height: 10px; }
  .hv-status { display: inline-flex; align-items: center; gap: 3px; font-size: 7.5px; font-weight: 500; font-variant-numeric: tabular-nums; color: var(--hv-emerald); }
  .hv-status-ok { display: inline-flex; }
  .hv-status-ok svg { width: 10px; height: 10px; }
  .hv-status-spin {
    display: none;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    border: 1.2px solid var(--hv-line);
    border-top-color: var(--hv-run);
    animation: hv-rotate 0.8s linear infinite;
  }
  .heroapp[data-recompiling] .hv-scene[data-scene="project"] .hv-status-ok { display: none; }
  .heroapp[data-recompiling] .hv-scene[data-scene="project"] .hv-status-spin { display: inline-block; }
  .heroapp[data-recompiling] .hv-scene[data-scene="project"] .hv-status-t { color: var(--hv-mut); }
  .hv-pv-right { display: flex; align-items: center; gap: 1px; margin-left: auto; }
  .hv-zoom {
    display: inline-flex;
    align-items: center;
    gap: 2.5px;
    height: 19px;
    padding: 0 4px;
    font-size: 8.5px;
    font-variant-numeric: tabular-nums;
    color: var(--hv-mut);
  }
  .hv-zoom svg { width: 7.5px; height: 7.5px; }
  .hv-pgnav { display: inline-flex; align-items: center; gap: 2px; }
  .hv-pgbox {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 19px;
    height: 16px;
    border: 1px solid rgba(255, 255, 255, 0.15);
    border-radius: 3px;
    background: var(--hv-bg);
    font-size: 7.8px;
    color: var(--hv-fg);
  }
  .hv-pgof { font-size: 8.2px; color: var(--hv-mut); padding: 0 2px; white-space: nowrap; }
  .hv-pgmode {
    display: inline-flex;
    padding: 1px;
    gap: 1px;
    border-radius: 4px;
    background: rgba(255, 255, 255, 0.06);
    margin: 0 2px;
  }
  .hv-pgmode .hv-ib-s { width: 16px; height: 14px; border-radius: 3px; color: var(--hv-mut2); }
  .hv-pgmode .hv-ib-s svg { width: 8px; height: 8px; }
  .hv-pgmode .is-on { background: var(--hv-panel); color: var(--hv-fg); box-shadow: 0 1px 2px rgba(0, 0, 0, 0.3); }

  /* boot vs compiled toolbar variants (project scene only) */
  .heroapp:not([data-compiled]) .hv-scene[data-scene="project"] .only-done { display: none; }
  .heroapp[data-compiled] .hv-scene[data-scene="project"] .only-boot { display: none; }

  .hv-pv-body {
    position: relative;
    flex: 1;
    min-height: 0;
    overflow: hidden;
    background: var(--hv-panel);
  }

  /* compile startup progress */
  .hv-startup {
    position: absolute;
    inset: 0;
    z-index: 3;
    display: flex;
    flex-direction: column;
    justify-content: center;
    margin: 0 auto;
    width: 363px;
    max-width: 88%;
    transition: opacity 0.35s ease;
  }
  .heroapp[data-compiled] .hv-scene[data-scene="project"] .hv-startup { opacity: 0; visibility: hidden; }
  .hv-su-head { display: flex; align-items: center; gap: 7px; }
  .hv-su-fic { display: inline-flex; color: var(--hv-mut); }
  .hv-su-fic svg { width: 11.5px; height: 11.5px; }
  .hv-su-title {
    font-size: 10px;
    font-weight: 600;
    background: linear-gradient(90deg, #fafafa 30%, #6a6a6a 50%, #fafafa 70%);
    background-size: 200% 100%;
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    animation: hv-shimmer 2s linear infinite;
  }
  @keyframes hv-shimmer { to { background-position: -200% 0; } }
  .heroapp[data-scene="project"]:not([data-compiled]) #hvCpLabel,
  .heroapp[data-recompiling] #hvCpLabel,
  .heroapp[data-ai-compiling] #hvCpLabel,
  .hv-home:not([data-home-compile="done"]) .hv-created-compile-label,
  .hv-home:not([data-home-compile="done"]) #hvHomeCompileTitle,
  .hv-diagram-scene[data-diagram-state="compiling"] #hvDiagramCompileLabel,
  .hv-diagram-scene[data-diagram-state="compiling"] .hv-dgm-compile-overlay > span:last-child,
  .hv-diagram-scene[data-diagram-state="recompile"] #hvDiagramRecompileLabel {
    background: linear-gradient(90deg, rgba(255,255,255,.58) 0%, rgba(255,255,255,.58) 40%, #fff 50%, rgba(255,255,255,.58) 60%, rgba(255,255,255,.58) 100%);
    background-size: 200% 100%;
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
    color: transparent;
    animation: hv-shimmer 1.6s linear infinite;
  }
  .hv-su-pulse { width: 4.5px; height: 4.5px; border-radius: 50%; background: var(--hv-run); animation: hv-pulse 1.6s ease infinite; }
  @keyframes hv-pulse { 50% { opacity: 0.35; } }
  .hv-su-count { margin-left: auto; font-family: var(--hv-mono); font-size: 7.5px; color: var(--hv-mut); font-variant-numeric: tabular-nums; }
  .hv-su-bars { display: flex; gap: 3px; margin-top: 8px; }
  .hv-su-bar { height: 3px; flex: 1; border-radius: 999px; background: rgba(161, 161, 161, 0.25); transition: background 0.5s ease; }
  .hv-su-bar.done { background: var(--hv-emerald); }
  .hv-su-bar.run { background: var(--hv-run); animation: hv-pulse 1.6s ease infinite; }
  .hv-su-meta { margin-top: 5px; font-family: var(--hv-mono); font-size: 7.5px; color: var(--hv-mut); }
  .hv-su-list { list-style: none; margin: 9px 0 0; padding: 0; }
  .hv-su-item { display: flex; align-items: center; gap: 9px; padding: 8px 0; }
  .hv-su-item + .hv-su-item { border-top: 1px solid rgba(255, 255, 255, 0.05); }
  .hv-su-ic { display: inline-flex; align-items: center; justify-content: center; width: 14px; height: 14px; flex-shrink: 0; }
  .hv-su-check { display: none; color: var(--hv-emerald); }
  .hv-su-check svg { width: 13px; height: 13px; }
  .hv-su-spin {
    display: none;
    width: 11px;
    height: 11px;
    border-radius: 50%;
    border: 1.4px solid rgba(59, 130, 246, 0.25);
    border-top-color: var(--hv-run);
    animation: hv-rotate 0.8s linear infinite;
  }
  .hv-su-dot { display: none; width: 4.5px; height: 4.5px; border-radius: 50%; background: rgba(161, 161, 161, 0.4); }
  .hv-su-item.done .hv-su-check { display: inline-flex; }
  .hv-su-item.run .hv-su-spin { display: inline-block; }
  .hv-su-item.q .hv-su-dot { display: inline-block; }
  .hv-su-txt { display: flex; flex-direction: column; min-width: 0; gap: 1px; }
  .hv-su-label { font-size: 8.5px; font-weight: 500; color: var(--hv-fg); }
  .hv-su-item.q .hv-su-label { color: var(--hv-mut); }
  .hv-su-detail { font-size: 7.2px; color: var(--hv-mut); }
  .hv-su-status {
    margin-left: auto;
    flex-shrink: 0;
    font-family: var(--hv-mono);
    font-size: 7.2px;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }
  .hv-su-item.done .hv-su-status { color: var(--hv-emerald); }
  .hv-su-item.done .hv-su-status::before { content: "done"; }
  .hv-su-item.run .hv-su-status { color: #60a5fa; }
  .hv-su-item.run .hv-su-status::before { content: "running"; }
  .hv-su-item.q .hv-su-status { color: rgba(161, 161, 161, 0.7); }
  .hv-su-item.q .hv-su-status::before { content: "queued"; }

  /* rendered pages */
  .hv-pv-pages {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 10px;
    height: 100%;
    padding-top: 10px;
    overflow: hidden;
  }
