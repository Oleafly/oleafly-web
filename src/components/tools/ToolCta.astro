---
/**
 * Closing CTA band for the free-tool pages: bridges the tool's value to the
 * desktop app with a download action. Self-contained styles (tool pages don't
 * load landing.css).
 */
import { DEFAULT_LOCALE, type Locale } from "../../i18n/locales";
import { localePath } from "../../i18n/paths";

interface Props {
  title: string;
  body: string;
  locale?: Locale;
}

const { title, body } = Astro.props;
const locale: Locale = Astro.props.locale ?? DEFAULT_LOCALE;
const RELEASES = "https://github.com/Oleafly/Oleafly/releases/latest";
---

<section class="tool-cta">
  <div class="tool-cta-inner">
    <h2>{title}</h2>
    <p>{body}</p>
    <div class="tool-cta-actions">
      <a class="tool-cta-btn" href={RELEASES} target="_blank" rel="noopener noreferrer">
        Download Oleafly, free
      </a>
      <a class="tool-cta-link" href={localePath(locale, "/templates/")}>Browse the templates</a>
    </div>
    <p class="tool-cta-note">macOS · Windows · Linux · no account, no telemetry</p>
  </div>
</section>

<style>
  .tool-cta {
    border-top: 1px solid rgba(255, 255, 255, 0.08);
    background: linear-gradient(180deg, rgba(37, 99, 235, 0.06), transparent 70%);
    padding: 52px 24px 60px;
  }
  .tool-cta-inner {
    max-width: 640px;
    margin: 0 auto;
    text-align: center;
  }
  .tool-cta h2 {
    font-size: clamp(1.3rem, 2.6vw, 1.7rem);
    letter-spacing: -0.015em;
    margin-bottom: 12px;
  }
  .tool-cta p {
    color: rgba(200, 205, 214, 0.85);
    font-size: 15px;
    line-height: 1.65;
  }
  .tool-cta-actions {
    margin-top: 24px;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 18px;
    flex-wrap: wrap;
  }
  .tool-cta-btn {
    display: inline-block;
    padding: 12px 26px;
    border-radius: 10px;
    background: linear-gradient(135deg, #2563eb, #34b44a);
    color: #fff;
    font-weight: 600;
    font-size: 15px;
    text-decoration: none;
    transition: transform 160ms ease, box-shadow 160ms ease;
    box-shadow: 0 8px 24px rgba(37, 99, 235, 0.35);
  }
  .tool-cta-btn:hover {
    transform: translateY(-1px);
    box-shadow: 0 12px 30px rgba(37, 99, 235, 0.45);
  }
  .tool-cta-link {
    color: rgba(200, 205, 214, 0.9);
    font-size: 14px;
    text-decoration: none;
    border-bottom: 1px solid rgba(255, 255, 255, 0.2);
    padding-bottom: 2px;
  }
  .tool-cta-link:hover {
    border-bottom-color: rgba(255, 255, 255, 0.5);
  }
  .tool-cta-note {
    margin-top: 16px;
    font-size: 12.5px;
    color: rgba(160, 166, 178, 0.9);
    letter-spacing: 0.01em;
  }
  @media (prefers-reduced-motion: reduce) {
    .tool-cta-btn {
      transition: none;
    }
  }
</style>
