---
// Classic GitHub star button: [★ Star | count] two-segment pill, used in the
// navs of the landing page and interior pages. Count is best-effort from the
// public GitHub API; the count segment hides itself when empty.
const GITHUB = "https://github.com/Oleafly/Oleafly";
---

<div class="gh-star">
  <a class="gh-star-btn" href={GITHUB} target="_blank" rel="noopener noreferrer">
    <svg width="13" height="13" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
      <path
        d="M8 .25a.75.75 0 0 1 .673.418l1.882 3.815 4.21.612a.75.75 0 0 1 .416 1.279l-3.046 2.97.719 4.192a.75.75 0 0 1-1.088.791L8 12.347l-3.766 1.98a.75.75 0 0 1-1.088-.79l.72-4.194L.818 6.374a.75.75 0 0 1 .416-1.28l4.21-.611L7.327.668A.75.75 0 0 1 8 .25Z"
      ></path>
    </svg>
    <span>Star</span>
  </a>
  <a
    class="gh-star-count"
    href={`${GITHUB}/stargazers`}
    target="_blank"
    rel="noopener noreferrer"
    data-gh-star-count
    aria-label="GitHub stargazers"
  ></a>
</div>

<style>
  .gh-star {
    display: inline-flex;
    align-items: stretch;
    border-radius: 8px;
    overflow: hidden;
    border: 1px solid rgba(240, 246, 252, 0.12);
    background: #21262d;
    flex-shrink: 0;
  }
  .gh-star-btn {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 6px 12px;
    color: #e6edf3;
    font-size: 12.5px;
    font-weight: 600;
    text-decoration: none;
    transition: background-color 160ms ease;
  }
  .gh-star-btn svg {
    color: #f0be50;
  }
  .gh-star-btn:hover {
    background: #30363d;
  }
  .gh-star-count {
    display: inline-flex;
    align-items: center;
    padding: 6px 10px;
    border-left: 1px solid rgba(240, 246, 252, 0.12);
    color: #e6edf3;
    font-size: 12.5px;
    font-weight: 600;
    font-variant-numeric: tabular-nums;
    text-decoration: none;
    background: #1c2128;
    transition: background-color 160ms ease;
  }
  .gh-star-count:hover {
    background: #30363d;
  }
  .gh-star-count:empty {
    display: none;
  }
  @media (max-width: 760px) {
    .gh-star {
      display: none;
    }
  }
</style>

<script>
  // Best-effort; silent on failure or rate limit.
  fetch("https://api.github.com/repos/Oleafly/Oleafly")
    .then((r) => (r.ok ? r.json() : null))
    .then((d) => {
      const n = d?.stargazers_count;
      if (typeof n !== "number") return;
      const text = n >= 1000 ? `${(n / 1000).toFixed(1)}k` : String(n);
      document.querySelectorAll("[data-gh-star-count]").forEach((el) => {
        el.textContent = text;
      });
    })
    .catch(() => {});
</script>
