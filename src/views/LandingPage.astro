---

<html lang={meta.lang} dir={meta.dir}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={`https://oleafly.com${lp("/") === "/" ? "/" : lp("/")}`} />
    {landingAlternates.map((a) => (
      <link rel="alternate" hreflang={a.hreflang} href={a.href} />
    ))}
    <link rel="alternate" hreflang="x-default" href="https://oleafly.com/" />
    <link rel="icon" href="/favicon.png" type="image/png" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Oleafly" />
    <meta property="og:title" content="Oleafly: Write research papers 10x faster, in one free app" />
    <meta property="og:description" content={description} />
    <meta property="og:url" content="https://oleafly.com/" />
    <meta property="og:image" content="https://oleafly.com/og.png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="The Oleafly editor with LaTeX source and a live PDF preview" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="keywords" content="LaTeX editor, offline LaTeX editor, Overleaf alternative, LaTeX resume builder, ATS resume checker, AI LaTeX assistant, free LaTeX app Mac Windows Linux" />
    <meta name="twitter:title" content="Oleafly: Write LaTeX like you write code" />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content="https://oleafly.com/og.png" />

    <link
      rel="preload"
      as="image"
      imagesrcset={heroPreload.srcSet.attribute}
      imagesizes="(max-width: 760px) 94vw, 1080px"
      fetchpriority="high"
    />
    <link rel="preload" href="/fonts/inter-var-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/jbmono-var-latin.woff2" as="font" type="font/woff2" crossorigin />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    <Analytics />
    </head>

  <body class="leaf-cursor">
    <LocalePreference />
    <a class="skip" href="#main">{t(locale, "nav.skip")}</a>
    <ScrollProgress client:idle className="h-[2px]" />

    <header class="nav" id="nav">
      <div class="nav-inner">
        <a class="brand" href={lp("/")}>
          <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true">
            <path
