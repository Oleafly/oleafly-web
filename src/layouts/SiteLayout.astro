---
// Landing-theme chrome for interior pages: same nav, footer, tokens, and
// section language as index.astro (which stays self-contained).
import "../styles/magicui.css";
import "../styles/landing.css";
import DownloadButton from "../components/DownloadButton.astro";
import PlatformDownloadInit from "../components/PlatformDownloadInit.astro";
import Analytics from "../components/Analytics.astro";
import SocialLinks from "../components/SocialLinks.astro";
import GithubStar from "../components/GithubStar.astro";
import LanguageSwitcher from "../components/LanguageSwitcher.astro";
import { DEFAULT_LOCALE, LOCALE_META, type Locale } from "../i18n/locales";
import { absoluteLocaleUrl, hreflangAlternates, localePath } from "../i18n/paths";
import { t } from "../i18n/t";

interface Props {
  title: string;
  description: string;
  /** Logical (unprefixed) path, e.g. "/tools/" */
  path: string;
  locale?: Locale;
  bodyClass?: string;
}

const { title, description, path, locale = DEFAULT_LOCALE, bodyClass } = Astro.props;
const meta = LOCALE_META[locale];
const GITHUB = "https://github.com/Oleafly/Oleafly";
const RELEASES = `${GITHUB}/releases/latest`;
const lp = (p: string) => localePath(locale, p);
const canonical = absoluteLocaleUrl(locale, path);
const alternates = hreflangAlternates(path);
---

<!doctype html>
<html lang={meta.lang} dir={meta.dir}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {
      alternates.map((a) => (
        <link rel="alternate" hreflang={a.hreflang} href={a.href} />
      ))
    }
    <link rel="alternate" hreflang="x-default" href={absoluteLocaleUrl(DEFAULT_LOCALE, path)} />
    <link rel="icon" href="/favicon.png" type="image/png" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Oleafly" />
    <meta property="og:locale" content={meta.lang.replace("-", "_")} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content="https://oleafly.com/og.png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content="https://oleafly.com/og.png" />

    <link rel="preload" href="/fonts/inter-var-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/jbmono-var-latin.woff2" as="font" type="font/woff2" crossorigin />
    <slot name="head" />
    <Analytics />
  </head>

  <body class={bodyClass}>
    <a class="skip" href="#main">{t(locale, "nav.skip")}</a>

    <header class="nav" id="nav">
      <div class="nav-inner">
        <a class="brand" href={lp("/")}>
          <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true">
            <path
              d="M21 2C6 2 4 16 3 22h1.998c.666-3.333 2.333-5.166 5.002-5.5 4-.5 7-4 8-7l-1.5-1 1-1c1-1 2.004-2.5 3.5-5.5z"
              fill="#34B44A"></path>
          </svg>
          <span>Oleafly</span>
        </a>
        <nav class="nav-links" aria-label={t(locale, "nav.main")}>
          <a href={lp("/#features")}>{t(locale, "nav.features")}</a>
          <a href={lp("/learn/")}>{t(locale, "nav.learn")}</a>
          <a href={lp("/templates/")}>{t(locale, "nav.templates")}</a>
          <a href={lp("/blog/")}>{t(locale, "nav.blog")}</a>
          <a href={lp("/tools/")}>{t(locale, "nav.tools")}</a>
          <a href={lp("/deadlines/")}>{t(locale, "nav.deadlines")}</a>
          <a href={lp("/docs/overview/")} target="_blank" rel="noopener noreferrer"
            >{t(locale, "nav.docs")}</a
          >
          <a href={GITHUB} target="_blank" rel="noopener noreferrer">{t(locale, "nav.github")}</a>
        </nav>
        <div class="nav-cta">
          <GithubStar />
          <LanguageSwitcher locale={locale} path={path} />
          <DownloadButton href={RELEASES} size="sm" label={t(locale, "nav.download")} />
          <button
            class="nav-burger"
            id="nav-burger"
            type="button"
            aria-label={t(locale, "nav.openMenu")}
            aria-expanded="false"
            aria-controls="nav"
          >
            <svg
              width="20"
              height="20"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              aria-hidden="true"
              ><path d="M4 7h16M4 12h16M4 17h16"></path></svg
            >
          </button>
        </div>
      </div>
    </header>

    <script>
      const navEl = document.getElementById("nav");
      const burger = document.getElementById("nav-burger");
      burger?.addEventListener("click", (e) => {
        e.stopPropagation();
        const open = navEl!.classList.toggle("nav-open");
        burger.setAttribute("aria-expanded", String(open));
      });
      document.addEventListener("click", (e) => {
        if (navEl && !navEl.contains(e.target as Node)) navEl.classList.remove("nav-open");
      });
      document.addEventListener("keydown", (e) => {
        if (e.key === "Escape") navEl?.classList.remove("nav-open");
      });
      for (const a of navEl?.querySelectorAll(".nav-links a") ?? []) {
        a.addEventListener("click", () => navEl?.classList.remove("nav-open"));
      }
    </script>

    <main id="main">
      <slot />
    </main>

    <footer class="footer">
      <div class="container footer-inner">
        <div class="footer-brand">
          <a class="brand" href={lp("/")}>
            <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
              <path
                d="M21 2C6 2 4 16 3 22h1.998c.666-3.333 2.333-5.166 5.002-5.5 4-.5 7-4 8-7l-1.5-1 1-1c1-1 2.004-2.5 3.5-5.5z"
                fill="#34B44A"></path>
            </svg>
            <span>Oleafly</span>
          </a>
          <p>{t(locale, "footer.tagline")}</p>
          <p class="footer-license">{t(locale, "footer.license")}</p>
          <SocialLinks />
        </div>
        <nav class="footer-col" aria-label={t(locale, "footer.product")}>
          <p class="footer-h">{t(locale, "footer.product")}</p>
          <a href={RELEASES} target="_blank" rel="noopener noreferrer">{t(locale, "footer.download")}</a>
          <a href={lp("/templates/")}>{t(locale, "footer.templates")}</a>
          <a href={lp("/privacy/")}>{t(locale, "footer.privacy")}</a>
        </nav>
        <nav class="footer-col" aria-label={t(locale, "footer.freeTools")}>
          <p class="footer-h">{t(locale, "footer.freeTools")}</p>
          <a href={lp("/learn/")}>{t(locale, "footer.learnLatex")}</a>
          <a href={lp("/tools/bibtex-validator/")}>{t(locale, "footer.bibtex")}</a>
          <a href={lp("/tools/equation-preview/")}>{t(locale, "footer.equation")}</a>
          <a href={lp("/tools/table-generator/")}>{t(locale, "footer.table")}</a>
          <a href={lp("/live/")}>{t(locale, "footer.live")}</a>
          <a href={lp("/tools/lab-search/")}>{t(locale, "footer.labSearch")}</a>
          <a href={lp("/deadlines/")}>{t(locale, "footer.deadlines")}</a>
        </nav>
        <nav class="footer-col" aria-label={t(locale, "footer.project")}>
          <p class="footer-h">{t(locale, "footer.project")}</p>
          <a href={lp("/docs/overview/")}>{t(locale, "footer.docs")}</a>
          <a href={lp("/learn/")}>{t(locale, "footer.learnLatex")}</a>
          <a href={GITHUB} target="_blank" rel="noopener noreferrer">{t(locale, "nav.github")}</a>
          <a href={`${GITHUB}/discussions`} target="_blank" rel="noopener noreferrer"
            >{t(locale, "footer.discussions")}</a
          >
        </nav>
      </div>
      <div class="footer-wordmark" aria-hidden="true">Oleafly</div>
    </footer>

    <script>
      const nav = document.getElementById("nav");
      const onScroll = () => nav?.classList.toggle("scrolled", window.scrollY > 8);
      onScroll();
      window.addEventListener("scroll", onScroll, { passive: true });
    </script>
    <PlatformDownloadInit />
  </body>
</html>
