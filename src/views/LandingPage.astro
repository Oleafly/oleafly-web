      }
      .btn-primary:active {
        transform: translateY(2px);
        box-shadow: 0 2px 0 var(--outline);
      }
      .btn-ghost {
        background: var(--surface);
        color: var(--ink);
        border: 3px solid var(--outline);
        font-family: var(--font-ui);
        font-weight: 800;
        border-radius: 999px;
        box-shadow: 0 4px 0 var(--outline);
      }
      .btn-ghost:hover {
        background: #fff;
        color: var(--ink);
        border-color: var(--outline);
        transform: translateY(-1px);
      }

      /* ===== Nav ===== */
      .nav {
        position: sticky;
        top: 0;
        z-index: 50;
        background: rgba(255, 249, 237, 0.94);
        backdrop-filter: blur(10px);
        -webkit-backdrop-filter: blur(10px);
        border-bottom: 3px solid var(--outline);
        transition: border-color 150ms ease, box-shadow 150ms ease;
      }
      .nav.scrolled {
        border-bottom-color: var(--line);
      }
      .nav-inner {
        max-width: 1080px;
        margin: 0 auto;
        padding: 0 24px;
        height: 56px;
        display: flex;
        align-items: center;
        gap: 24px;
      }
      .brand {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        font-weight: 600;
        font-size: 16px;
        letter-spacing: -0.01em;
        text-decoration: none;
        color: var(--ink);
        font-family: var(--font);
      }
      .nav-links {
        display: flex;
        gap: 4px;
        margin-left: 8px;
      }
      .nav-links a {
        font-size: 13px;
        font-weight: 500;
        color: var(--muted);
        text-decoration: none;
        padding: 6px 10px;
        border-radius: var(--radius-md);
        transition: color 150ms ease, background 150ms ease;
      }
      .nav-links a:hover {
        color: var(--ink);
        background: var(--surface-hover, #ffe8a3);
      }
      .nav-cta {
        margin-left: auto;
        display: flex;
        align-items: center;
        gap: 8px;
      }
      .nav-burger {
        display: none;
        align-items: center;
        justify-content: center;
        width: 36px;
        height: 36px;
        background: transparent;
        border: 1px solid var(--line-strong);
        border-radius: var(--radius-md);
        color: var(--text);
        cursor: pointer;
      }
      .nav-burger:hover {
        background: var(--surface-hover, #ffe8a3);
        color: var(--ink);
        border-color: var(--outline);
      }
      @media (max-width: 760px) {
        .nav-burger {
          display: inline-flex;
        }
        .nav-links {
          display: none;
          position: absolute;
          top: 100%;
          left: 0;
          right: 0;
          flex-direction: column;
          gap: 2px;
          margin: 0;
          padding: 10px 16px 16px;
          background: rgba(255, 249, 237, 0.98);
          -webkit-backdrop-filter: blur(12px);
          backdrop-filter: blur(12px);
          border-bottom: 1px solid var(--line);
        }
        .nav.nav-open .nav-links {
          display: flex;
        }
        .nav-links a {
          font-size: 15px;
          padding: 10px 12px;
        }
