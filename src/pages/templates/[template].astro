---
import data from "../../data/template-packs.json";
import TemplateDetailPage from "../../views/TemplateDetailPage.astro";
import { DEFAULT_LOCALE } from "../../i18n/locales";

export function getStaticPaths() {
  return data.packs.flatMap((pack) =>
    pack.templates.map((t) => ({
      params: { template: t.id },
      props: { template: t, packLabel: pack.label, packId: pack.id },
    })),
  );
}

const { template, packLabel, packId } = Astro.props;
---
<TemplateDetailPage
  template={template}
  packLabel={packLabel}
  packId={packId}
  locale={DEFAULT_LOCALE}
/>
