---
import SiteLayout from "../../layouts/SiteLayout.astro";
import DownloadButton from "../../components/DownloadButton.astro";

const RELEASES = "https://github.com/Oleafly/Oleafly/releases/latest";

const tools = [
  {
    href: "/tools/lab-search/",
    name: "Lab search",
    desc: "Search millions of research institutions worldwide with publication counts and official links, powered by the open OpenAlex dataset.",
  },
  {
    href: "/tools/bibtex-validator/",
    name: "BibTeX validator",
    desc: "Paste a .bib file and catch missing required fields, duplicate keys, and duplicate DOIs before they become [?] in your PDF.",
  },
  {
    href: "/live/",
    name: "Live LaTeX playground",
    desc: "Type LaTeX and watch it render as you type: mixed prose and math, align, matrices, cases. Loads any example from the Learn course.",
  },
  {
    href: "/tools/equation-preview/",
    name: "Equation preview",
    desc: "Type LaTeX math and see it rendered instantly. Switch between inline and display mode and copy ready-to-paste code.",
  },
  {
    href: "/tools/table-generator/",
    name: "Table generator",
    desc: "Fill a visual grid and get clean tabular code out, with booktabs rules, per-column alignment, and a caption.",
  },
  {
    href: "/deadlines/",
    name: "Conference deadlines",
    desc: "Live countdowns to CS conference submission deadlines, with CCF and CORE ranks, from the open ccf-deadlines dataset.",
  },
];

const appOnly = [
  {
    name: "PDF to LaTeX",
    desc: "Reconstruct many text-based PDFs into editable LaTeX projects locally, figures extracted, no AI required. Built into the free desktop app.",
  },
  {
    name: "Word to LaTeX",
    desc: "Import a .docx through a managed Pandoc and get a compiling LaTeX project with images preserved. Built into the free desktop app.",
  },
  {
    name: "Image to LaTeX",
    desc: "Photograph an equation or table and insert it as LaTeX using your own AI key. Built into the free desktop app.",
  },
];
---

<SiteLayout
  title="Free LaTeX tools that run in your browser | Oleafly"
  description="Free browser-based research tools from Oleafly: BibTeX validator, live equation preview, LaTeX table generator, academic lab search, and conference deadline countdowns."
  path="/tools/"
>
  <section class="page-hero">
    <div class="container">
      <p class="eyebrow">Free tools</p>
      <h1>LaTeX tools that run in your browser</h1>
      <p class="sub">
        Free, no sign-up, no upload of your work. The validator, equation preview, and table
        generator run entirely in your browser; lab search and deadlines query open datasets
        (OpenAlex, ccf-deadlines). Your source never leaves the page, the same local-first
        posture the <a href="/">Oleafly</a> desktop app takes with your documents.
      </p>
      <div class="card-grid">
        {
          tools.map((t) => (
            <a class="ol-card" href={t.href} style="text-decoration:none">
              <h3>{t.name}</h3>
              <p>{t.desc}</p>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <p class="eyebrow">In the desktop app</p>
      <h2>Heavier conversions live in the free app</h2>
      <p class="sub">
        Some conversions need a real compiler or your own AI key, so they run in the free,
        open-source desktop app instead of the browser. Your projects stay as plain files on
        your disk there too.
      </p>
      <div class="card-grid">
        {
          appOnly.map((t) => (
            <div class="ol-card">
              <h3>{t.name}</h3>
              <p>{t.desc}</p>
            </div>
          ))
        }
      </div>
      <p style="margin-top:28px">
        <DownloadButton
          href={RELEASES}
          size="lg"
          label="Download Oleafly for free"
          labelTemplate="Download Oleafly for {os}"
        />
      </p>
    </div>
  </section>
</SiteLayout>
