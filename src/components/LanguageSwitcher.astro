---
import {
  DEFAULT_LOCALE,
  LOCALES,
  LOCALE_META,
  flagImageUrl,
  type Locale,
} from "../i18n/locales";
import { localePath, parseLocalePath } from "../i18n/paths";
import { t } from "../i18n/t";

interface Props {
  locale?: Locale;
  /** Unprefixed logical path, e.g. /learn/foo/ — defaults to current URL path without locale. */
  path?: string;
  class?: string;
}

const currentLocale =
  Astro.props.locale ??
  parseLocalePath(Astro.url.pathname).locale ??
  DEFAULT_LOCALE;

const logicalPath =
  Astro.props.path ?? parseLocalePath(Astro.url.pathname).path;

const current = LOCALE_META[currentLocale];
const label = t(currentLocale, "nav.selectLanguage");
const className = Astro.props.class ?? "";
---

<div class:list={["lang-switcher", className]} data-lang-switcher>
  <button
    type="button"
    class="lang-switcher-btn"
    aria-haspopup="listbox"
    aria-expanded="false"
    aria-label={`${current.nativeLabel}, ${label}`}
    data-lang-trigger
  >
    <img
      class="lang-switcher-flag"
      src={flagImageUrl(current.flagIso, 40)}
      width="18"
      height="13"
      alt=""
      decoding="async"
      loading="eager"
      aria-hidden="true"
    />
    <span class="lang-switcher-label">{current.nativeLabel}</span>
    <svg
      class="lang-switcher-caret"
      width="12"
      height="12"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2.5"
      aria-hidden="true"
    >
      <path d="M6 9l6 6 6-6"></path>
    </svg>
  </button>
  <ul class="lang-switcher-menu" role="listbox" hidden data-lang-menu>
    {
      LOCALES.map((code) => {
        const meta = LOCALE_META[code];
        const href = localePath(code, logicalPath);
        const active = code === currentLocale;
        return (
          <li role="option" aria-selected={active}>
            <a
              href={href}
              class:list={["lang-switcher-option", { "is-active": active }]}
              hreflang={meta.lang}
              lang={meta.lang}
              data-locale={code}
            >
              <span class="lang-switcher-option-main">
                <img
                  class="lang-switcher-flag"
                  src={flagImageUrl(meta.flagIso, 40)}
                  width="18"
                  height="13"
                  alt=""
                  decoding="async"
                  loading="lazy"
                  aria-hidden="true"
                />
                <span class="lang-switcher-native">{meta.nativeLabel}</span>
              </span>
              {active ? (
                <span class="lang-switcher-check" aria-hidden="true">✓</span>
              ) : null}
            </a>
          </li>
        );
      })
    }
  </ul>
</div>

<script>
  function initLangSwitcher(root: Element) {
    const btn = root.querySelector<HTMLButtonElement>("[data-lang-trigger]");
    const menu = root.querySelector<HTMLElement>("[data-lang-menu]");
    if (!btn || !menu) return;

    const close = () => {
      menu.hidden = true;
      btn.setAttribute("aria-expanded", "false");
    };
    const open = () => {
      menu.hidden = false;
      btn.setAttribute("aria-expanded", "true");
    };
    const toggle = () => (menu.hidden ? open() : close());

    btn.addEventListener("click", (e) => {
      e.stopPropagation();
      toggle();
    });

    menu.querySelectorAll<HTMLAnchorElement>("a[data-locale]").forEach((a) => {
      a.addEventListener("click", () => {
        const loc = a.dataset.locale;
        if (loc) {
          try {
            localStorage.setItem("oleafly-locale", loc);
          } catch {
            /* ignore */
          }
        }
      });
    });

    document.addEventListener("click", (e) => {
      if (!root.contains(e.target as Node)) close();
    });
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape") close();
    });
  }

  document.querySelectorAll("[data-lang-switcher]").forEach(initLangSwitcher);
</script>

<style>
  .lang-switcher {
    position: relative;
    display: inline-flex;
  }
  .lang-switcher-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    height: 32px;
    padding: 0 0.55rem 0 0.45rem;
    border-radius: var(--radius-md, 6px);
    border: 1px solid var(--line, rgba(255, 255, 255, 0.08));
    background: transparent;
    color: var(--muted, #8a8f98);
    font: inherit;
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 0.01em;
    cursor: pointer;
    transition:
      color 0.15s ease,
      border-color 0.15s ease,
      background 0.15s ease;
  }
  .lang-switcher-btn:hover {
    color: var(--ink, var(--text, #f7f8f8));
    border-color: var(--outline, var(--line-strong, rgba(255, 255, 255, 0.14)));
    background: var(--surface-2, rgba(255, 255, 255, 0.04));
  }
  .lang-switcher-flag {
    width: 18px;
    height: 13px;
    object-fit: cover;
    border-radius: 2px;
    flex-shrink: 0;
    /* Keep a visible plate if the CDN image is blocked */
    background: rgba(255, 255, 255, 0.12);
    box-shadow: 0 0 0 1px rgba(255, 255, 255, 0.12);
  }
  .lang-switcher-label {
    max-width: 7.5rem;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .lang-switcher-caret {
    opacity: 0.6;
    flex-shrink: 0;
  }
  .lang-switcher-menu {
    position: absolute;
    top: calc(100% + 6px);
    right: 0;
    z-index: 80;
    min-width: 240px;
    max-height: min(70vh, 440px);
    overflow: auto;
    margin: 0;
    padding: 0.35rem;
    list-style: none;
    border-radius: 10px;
    border: 1px solid var(--line-strong, rgba(255, 255, 255, 0.14));
    background: var(--surface-2, #191a1c);
    box-shadow: var(--shadow-popup, 0 4px 16px rgba(0, 0, 0, 0.4));
  }
  .lang-switcher-option {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    padding: 0.5rem 0.65rem;
    border-radius: 6px;
    color: var(--text, #f7f8f8);
    text-decoration: none;
    font-size: 13px;
    line-height: 1.3;
  }
  .lang-switcher-option-main {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    min-width: 0;
  }
  .lang-switcher-option:hover {
    background: var(--accent-soft, rgba(255, 255, 255, 0.06));
    color: var(--ink, var(--text, #f7f8f8));
  }
  .lang-switcher-option.is-active {
    background: var(--accent-soft, rgba(37, 99, 235, 0.18));
    color: var(--brand-text, #60a5fa);
  }
  .lang-switcher-native {
    font-weight: 500;
  }
  .lang-switcher-check {
    font-size: 12px;
    opacity: 0.9;
    flex-shrink: 0;
  }
</style>
