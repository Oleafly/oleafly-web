---
// oleafly.com landing page.
//
// Design system: linear.app — near-black #08090A ground, neutral dark
// surfaces, white primary buttons, Oleafly's app blue #2563EB as the accent,
// Inter, tight spacing, radii ≤ 8px. Magic UI components supply the motion:
// DotPattern, AnimatedShinyText, BorderBeam, Marquee, RainbowButton,
// WordRotate, Highlighter, TextReveal, KineticText, VelocityScroll,
// GlyphMatrix, NoiseTexture, FileTree, CodeComparison (build-time shiki),
// AnimatedCircularProgressBar, ScrollProgress.
import { Image, getImage } from "astro:assets";
import heroEditor from "../assets/hero-editor.png";
import gitDiff from "../assets/git-diff.png";
import preflightAts from "../assets/preflight-ats.png";
import projectTemplates from "../assets/project-templates.png";
import { Marquee } from "../components/magicui/marquee";
import { DotPattern } from "../components/magicui/dot-pattern";
import { AnimatedShinyText } from "../components/magicui/animated-shiny-text";
import { BorderBeam } from "../components/magicui/border-beam";
import { ShineBorder } from "../components/magicui/shine-border";
import { RainbowLink } from "../components/RainbowLink";
import PlatformDownloadInit from "../components/PlatformDownloadInit.astro";
import Analytics from "../components/Analytics.astro";
import SocialLinks from "../components/SocialLinks.astro";
import LanguageSwitcher from "../components/LanguageSwitcher.astro";
import GithubStar from "../components/GithubStar.astro";
import LocalePreference from "../components/LocalePreference.astro";
import { WordRotate } from "../components/magicui/word-rotate";
import { Highlighter } from "../components/magicui/highlighter";
import { KineticText } from "../components/magicui/kinetic-text";
import { GlyphMatrix } from "../components/magicui/glyph-matrix";
import { NoiseTexture } from "../components/magicui/noise-texture";
import { AnimatedCircularProgressBar } from "../components/magicui/animated-circular-progress-bar";
import { ScrollProgress } from "../components/magicui/scroll-progress";
import { GridPattern } from "../components/magicui/grid-pattern";
import { ProjectFileTree } from "../components/ProjectFileTree";
import { BentoSection } from "../components/BentoSection";
import { LandingCards } from "../components/landing/LandingCards";
import { LandingFaq } from "../components/landing/LandingFaq";
import { VelocityStrip } from "../components/VelocityStrip";
import { PhilosophyReveal } from "../components/PhilosophyReveal";
import CodeComparison from "../components/CodeComparison.astro";
import "../styles/magicui.css";
import "../styles/external-links.css";
import { DEFAULT_LOCALE, LOCALE_META, type Locale } from "../i18n/locales";
import { hreflangAlternates, localePath } from "../i18n/paths";
import { t } from "../i18n/t";

interface Props {
  locale?: Locale;
}
const locale: Locale = Astro.props.locale ?? DEFAULT_LOCALE;
const meta = LOCALE_META[locale];
const lp = (path: string) => localePath(locale, path);
const landingAlternates = hreflangAlternates("/");

const heroPreload = await getImage({
  src: heroEditor,
  widths: [720, 1200, 1800],
  sizes: "(max-width: 760px) 94vw, 1080px",
  format: "webp",
});

const GITHUB = "https://github.com/Oleafly/Oleafly";
const RELEASES = `${GITHUB}/releases/latest`;
const likeCodeLine = t(locale, "landing.h1.likeCode");
const tenxMatch = /^10x\s+(.*)$/.exec(likeCodeLine);

const oneStopCards = [
  { name: t(locale, "landing.oneshop.c1t"), desc: t(locale, "landing.oneshop.c1d"), visual: "latex" },
  { name: t(locale, "landing.oneshop.c2t"), desc: t(locale, "landing.oneshop.c2d"), visual: "agent" },
  { name: t(locale, "landing.oneshop.c3t"), desc: t(locale, "landing.oneshop.c3d"), visual: "refs" },
  { name: t(locale, "landing.oneshop.c4t"), desc: t(locale, "landing.oneshop.c4d"), visual: "resume" },
  { name: t(locale, "landing.oneshop.c5t"), desc: t(locale, "landing.oneshop.c5d"), visual: "git" },
  { name: t(locale, "landing.oneshop.c6t"), desc: t(locale, "landing.oneshop.c6d"), visual: "pdf" },
];
const roadmapCards = [
  { name: t(locale, "landing.roadmap.r1t"), desc: t(locale, "landing.roadmap.r1d"), badge: "Coming soon" },
  { name: t(locale, "landing.roadmap.r2t"), desc: t(locale, "landing.roadmap.r2d"), badge: "Coming soon" },
  { name: t(locale, "landing.roadmap.r3t"), desc: t(locale, "landing.roadmap.r3d"), badge: "Coming soon" },
  { name: t(locale, "landing.roadmap.r4t"), desc: t(locale, "landing.roadmap.r4d"), badge: "Coming soon" },
];
const faqItems = [
  { q: t(locale, "landing.faq.q1"), a: t(locale, "landing.faq.a1") },
  { q: t(locale, "landing.faq.q2"), a: t(locale, "landing.faq.a2") },
  { q: t(locale, "landing.faq.q3"), a: t(locale, "landing.faq.a3") },
  { q: t(locale, "landing.faq.q4"), a: t(locale, "landing.faq.a4") },
  { q: t(locale, "landing.faq.q5"), a: t(locale, "landing.faq.a5") },
  { q: t(locale, "landing.faq.q6"), a: t(locale, "landing.faq.a6") },
  { q: t(locale, "landing.faq.q7"), a: t(locale, "landing.faq.a7") },
  { q: t(locale, "landing.faq.q8"), a: t(locale, "landing.faq.a8") },
