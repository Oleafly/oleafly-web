---
/**
 * Back link for individual free-tool pages → /tools/ (locale-aware).
 */
import { DEFAULT_LOCALE, type Locale } from "../../i18n/locales";
import { localePath } from "../../i18n/paths";
import { t } from "../../i18n/t";

interface Props {
  locale?: Locale;
}
const locale: Locale = Astro.props.locale ?? DEFAULT_LOCALE;
const href = localePath(locale, "/tools/");
const label = t(locale, "nav.tools");
---

<nav class="tool-back" aria-label={t(locale, "common.back")}>
  <a class="tool-back-link" href={href}>
    <svg
      width="16"
      height="16"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
    >
      <path d="M15 18l-6-6 6-6"></path>
    </svg>
    <span>{t(locale, "common.back")} · {label}</span>
  </a>
</nav>

<style>
  .tool-back {
    margin-bottom: 18px;
  }
  .tool-back-link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 13.5px;
    font-weight: 500;
    color: var(--brand-text);
    text-decoration: none;
    padding: 6px 0;
    transition: color 120ms ease;
  }
  .tool-back-link:hover {
    color: #93c5fd;
  }
  .tool-back-link svg {
    flex-shrink: 0;
    opacity: 0.9;
  }
</style>
