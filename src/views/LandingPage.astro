    </style>

    <script>
      // Playable doodles: zero-g float + drag/throw, bounce off section edges.
      (() => {
        const zones = [...document.querySelectorAll("[data-doodle-zone]")];
        if (!zones.length) return;
        const reduce = matchMedia("(prefers-reduced-motion: reduce)").matches;
        if (reduce) {
          zones.forEach((z) => z.classList.add("is-visible"));
          return;
        }

        // Reveal on scroll
        if ("IntersectionObserver" in window) {
          const io = new IntersectionObserver(
            (entries) => {
              for (const entry of entries) {
                const zone =
                  entry.target.querySelector?.("[data-doodle-zone]") || entry.target;
                if (!(zone instanceof HTMLElement)) continue;
                if (entry.isIntersecting) zone.classList.add("is-visible");
                else zone.classList.remove("is-visible");
              }
            },
            { threshold: 0.1, rootMargin: "0px 0px -6% 0px" },
          );
          zones.forEach((zone) => {
            const section = zone.closest("section") || zone;
            io.observe(section);
            if (section.classList.contains("hero")) {
              const r = section.getBoundingClientRect();
              if (r.top < innerHeight && r.bottom > 0) zone.classList.add("is-visible");
            }
          });
        } else {
          zones.forEach((z) => z.classList.add("is-visible"));
        }

        // Physics only where doodles are shown (desktop/tablet)
        if (!matchMedia("(min-width: 761px)").matches) return;

        const FRICTION = 0.985;
        const REST = 0.72; // bounce restitution
        const MAX_THROW = 28;
        const PAD = 6;
        // Always home: spring toward original slot after play
        const SPRING = 0.018; // pull strength toward home
        const SPRING_DAMP = 0.92; // extra damp on spring response
        const HOME_SNAP = 0.6; // px — settle fully when this close & slow
        const HOME_V = 0.12;

        /** @type {{ zone: HTMLElement, bodies: any[], active: boolean, running: boolean }[]} */
        const sims = [];

        const parseRot = (el) => {
          const v = getComputedStyle(el).getPropertyValue("--r").trim();
          const n = parseFloat(v);
          return Number.isFinite(n) ? n : 0;
        };

        const bootZone = (zone) => {
          if (!zone.hasAttribute("data-doodle-play")) return;
          zone.classList.add("is-playable");
          const wraps = [...zone.querySelectorAll(".doodle-wrap")];
          if (!wraps.length) return;

          // Wait a frame so CSS layout positions exist, then pin to px left/top.
          const measure = () => {
            const zr = zone.getBoundingClientRect();
            const bodies = wraps.map((el) => {
              const er = el.getBoundingClientRect();
              const w = el.offsetWidth || 48;
              const h = el.offsetHeight || 48;
              let x = er.left - zr.left;
              let y = er.top - zr.top;
              // CSS may use `right` — normalize to left/top only
              el.style.right = "auto";
              el.style.bottom = "auto";
              el.style.left = `${x}px`;
              el.style.top = `${y}px`;
              el.style.margin = "0";
              el.style.transform = `rotate(${parseRot(el)}deg)`;
              const homeRot = parseRot(el);
              const body = {
                el,
                x,
                y,
                w,
                h,
                homeX: x,
                homeY: y,
                homeRot,
                vx: (Math.random() - 0.5) * 0.25,
                vy: (Math.random() - 0.5) * 0.25,
                rot: homeRot,
                vr: (Math.random() - 0.5) * 0.08,
                dragging: false,
                ox: 0,
                oy: 0,
                samples: [],
              };
              const onDown = (e) => {
                if (e.button != null && e.button !== 0) return;
                e.preventDefault();
                body.dragging = true;
                el.classList.add("is-dragging");
                el.setPointerCapture?.(e.pointerId);
                const r = zone.getBoundingClientRect();
                body.ox = e.clientX - r.left - body.x;
                body.oy = e.clientY - r.top - body.y;
                body.vx = 0;
                body.vy = 0;
                body.samples = [{ t: performance.now(), x: body.x, y: body.y }];
              };
              const onMove = (e) => {
                if (!body.dragging) return;
                const r = zone.getBoundingClientRect();
                const maxX = Math.max(PAD, r.width - body.w - PAD);
                const maxY = Math.max(PAD, r.height - body.h - PAD);
                body.x = Math.min(maxX, Math.max(PAD, e.clientX - r.left - body.ox));
                body.y = Math.min(maxY, Math.max(PAD, e.clientY - r.top - body.oy));
                const t = performance.now();
                body.samples.push({ t, x: body.x, y: body.y });
                if (body.samples.length > 6) body.samples.shift();
                el.style.left = `${body.x}px`;
                el.style.top = `${body.y}px`;
              };
              const onUp = (e) => {
                if (!body.dragging) return;
                body.dragging = false;
                el.classList.remove("is-dragging");
                try {
                  el.releasePointerCapture?.(e.pointerId);
                } catch {}
                // Throw velocity from recent samples
                const s = body.samples;
                if (s.length >= 2) {
                  const a = s[0];
                  const b = s[s.length - 1];
                  const dt = Math.max(16, b.t - a.t);
                  body.vx = Math.max(-MAX_THROW, Math.min(MAX_THROW, ((b.x - a.x) / dt) * 16));
                  body.vy = Math.max(-MAX_THROW, Math.min(MAX_THROW, ((b.y - a.y) / dt) * 16));
                  body.vr = body.vx * 0.08 + (Math.random() - 0.5) * 0.3;
                }
                body.samples = [];
              };
              el.addEventListener("pointerdown", onDown);
              el.addEventListener("pointermove", onMove);
              el.addEventListener("pointerup", onUp);
              el.addEventListener("pointercancel", onUp);
              return body;
            });

            const sim = { zone, bodies, active: zone.classList.contains("is-visible"), running: true };
            sims.push(sim);

            // Track visibility for pausing off-screen sims
            if ("IntersectionObserver" in window) {
              const vio = new IntersectionObserver(
                ([entry]) => {
                  sim.active = entry.isIntersecting;
                },
                { threshold: 0.05 },
              );
              vio.observe(zone.closest("section") || zone);
            }
          };

          // Double rAF so percentage CSS positions resolve first
          requestAnimationFrame(() => requestAnimationFrame(measure));
        };

        document.querySelectorAll("[data-doodle-play]").forEach((z) => bootZone(z));

        let last = performance.now();
        const tick = (now) => {
          const dt = Math.min(32, now - last) / 16.67; // ~frames
          last = now;
          for (const sim of sims) {
            if (!sim.active || !sim.running) continue;
            const { zone, bodies } = sim;
            const bw = zone.clientWidth;
            const bh = zone.clientHeight;
            if (bw < 40 || bh < 40) continue;
            for (const b of bodies) {
              if (b.dragging) continue;

              // Spring back to original slot (always wins long-term)
              const dx = b.homeX - b.x;
              const dy = b.homeY - b.y;
              const dist = Math.hypot(dx, dy);
              b.vx += dx * SPRING * dt;
              b.vy += dy * SPRING * dt;
              // Stronger pull when far away so throws always return
              if (dist > 80) {
                b.vx += dx * SPRING * 0.6 * dt;
                b.vy += dy * SPRING * 0.6 * dt;
              }
              // Rotate gently toward home angle
              let dRot = b.homeRot - b.rot;
              while (dRot > 180) dRot -= 360;
              while (dRot < -180) dRot += 360;
              b.vr += dRot * 0.01 * dt;

              b.x += b.vx * dt;
              b.y += b.vy * dt;
              b.rot += b.vr * dt;
              b.vx *= Math.pow(FRICTION * SPRING_DAMP, dt);
              b.vy *= Math.pow(FRICTION * SPRING_DAMP, dt);
              b.vr *= Math.pow(FRICTION, dt);

              const maxX = bw - b.w - PAD;
              const maxY = bh - b.h - PAD;
              if (b.x < PAD) {
                b.x = PAD;
                b.vx = Math.abs(b.vx) * REST;
              } else if (b.x > maxX) {
                b.x = maxX;
                b.vx = -Math.abs(b.vx) * REST;
              }
              if (b.y < PAD) {
                b.y = PAD;
                b.vy = Math.abs(b.vy) * REST;
              } else if (b.y > maxY) {
                b.y = maxY;
                b.vy = -Math.abs(b.vy) * REST;
              }

              // Snap home when close and slow enough
              const speed = Math.hypot(b.vx, b.vy);
              if (dist < HOME_SNAP && speed < HOME_V) {
                b.x = b.homeX;
                b.y = b.homeY;
                b.vx = 0;
                b.vy = 0;
                b.rot = b.homeRot;
                b.vr = 0;
              }

              b.el.style.left = `${b.x}px`;
              b.el.style.top = `${b.y}px`;
              b.el.style.transform = `rotate(${b.rot}deg)`;
              b.el.style.setProperty("--r", `${b.rot}deg`);
            }
          }
          requestAnimationFrame(tick);
        };
        requestAnimationFrame(tick);

        // Keep bodies inside after resize
        let resizeT = 0;
        window.addEventListener(
          "resize",
          () => {
            clearTimeout(resizeT);
            resizeT = setTimeout(() => {
              for (const sim of sims) {
                // Re-measure home slots from current layout after resize
                const zr = sim.zone.getBoundingClientRect();
                // Keep relative offset from home, then reclamp; simpler: snap home
                for (const b of sim.bodies) {
                  // Scale home into new bounds if needed
                  const maxX = Math.max(PAD, sim.zone.clientWidth - b.w - PAD);
                  const maxY = Math.max(PAD, sim.zone.clientHeight - b.h - PAD);
                  b.homeX = Math.min(maxX, Math.max(PAD, b.homeX));
                  b.homeY = Math.min(maxY, Math.max(PAD, b.homeY));
                  b.x = Math.min(maxX, Math.max(PAD, b.x));
                  b.y = Math.min(maxY, Math.max(PAD, b.y));
                  b.el.style.left = `${b.x}px`;
                  b.el.style.top = `${b.y}px`;
                }
                void zr;
              }
            }, 120);
          },
          { passive: true },
        );
      })();

      // Eased smooth scroll for in-page links (accounts for the sticky nav
      // and the feature stack's sticky geometry).
      const docY = (el) => {
        let y = 0;
        while (el) {
          y += el.offsetTop;
          el = el.offsetParent;
        }
        return y;
      };
      const easeInOutCubic = (t) => (t < 0.5 ? 4 * t * t * t : 1 - Math.pow(-2 * t + 2, 3) / 2);
      document.querySelectorAll('a[href^="#"]').forEach((a) => {
        a.addEventListener("click", (e) => {
          const target = document.querySelector(a.getAttribute("href"));
          if (!target) return;
          e.preventDefault();
          const from = window.scrollY;
          const to = Math.max(0, docY(target) - 72);
          const dur = Math.min(1300, 450 + Math.abs(to - from) * 0.12);
          const t0 = performance.now();
          const step = (now) => {
            const t = Math.min(1, (now - t0) / dur);
            window.scrollTo({ top: from + (to - from) * easeInOutCubic(t), behavior: "instant" });
            if (t < 1) requestAnimationFrame(step);
            else history.replaceState(null, "", a.getAttribute("href"));
          };
          requestAnimationFrame(step);
        });
      });

      // Nav border on scroll.
      const nav = document.getElementById("nav");
      const onScroll = () => nav?.classList.toggle("scrolled", window.scrollY > 8);
      onScroll();
      window.addEventListener("scroll", onScroll, { passive: true });

      // Mobile menu toggle.
      const burger = document.getElementById("nav-burger");
      burger?.addEventListener("click", (e) => {
        e.stopPropagation();
        const open = nav.classList.toggle("nav-open");
        burger.setAttribute("aria-expanded", String(open));
      });
      document.addEventListener("click", (e) => {
        if (nav && !nav.contains(e.target)) nav.classList.remove("nav-open");
      });
      document.addEventListener("keydown", (e) => {
        if (e.key === "Escape") nav?.classList.remove("nav-open");
      });
      nav?.querySelectorAll(".nav-links a").forEach((a) => {
        a.addEventListener("click", () => nav.classList.remove("nav-open"));
      });

      // Feature stack: pinned deck without clipping. Desktop only — mobile
      // keeps static cards (no per-scroll transform thrash).
      const stackCards = [...document.querySelectorAll(".stack-card")];
      const reduceMotion = matchMedia("(prefers-reduced-motion: reduce)").matches;
      const isMobileStack = () => matchMedia("(max-width: 760px)").matches;
      if (stackCards.length && !reduceMotion) {
        let ticking = false;
        const clearStackStyles = () => {
          for (const card of stackCards) {
            card.style.transform = "";
            card.style.filter = "";
            card.style.top = "";
          }
        };
        const update = () => {
          ticking = false;
          const vh = window.innerHeight;
          if (isMobileStack()) {
            clearStackStyles();
            return;
          }
          for (let i = 0; i < stackCards.length; i++) {
            const card = stackCards[i];
            const pin = Math.min(80, vh - card.offsetHeight - 40);
            card.style.top = `${pin}px`;
            const next = stackCards[i + 1];
            let t = 0;
            if (next && card.getBoundingClientRect().top <= pin + 1) {
              const nTop = next.getBoundingClientRect().top;
              t = Math.min(1, Math.max(0, (vh - nTop) / (vh - Math.max(pin, 0))));
            }
            if (t > 0) {
              card.style.transform = `translateY(${-16 * t}px) scale(${1 - 0.055 * t}) rotateX(${4 * t}deg)`;
              card.style.filter = `brightness(${1 - 0.3 * t})`;
            } else {
              card.style.transform = "";
              card.style.filter = "";
            }
          }
        };
        const onStackScroll = () => {
          if (isMobileStack()) return;
          if (!ticking) {
            ticking = true;
            requestAnimationFrame(update);
          }
        };
        window.addEventListener("scroll", onStackScroll, { passive: true });
        window.addEventListener("resize", () => {
          if (isMobileStack()) clearStackStyles();
          else onStackScroll();
        }, { passive: true });
        if (!isMobileStack()) update();
      }

      // Quill confetti when the reader reaches the very bottom. Fires once
      // per visit, leaf-shaped in Oleafly greens, skipped for reduced motion.
      let confettiFired = false;
      let confettiModule = null;
      const QUILL_PATH =
        "M21 2C6 2 4 16 3 22h1.998c.666-3.333 2.333-5.166 5.002-5.5 4-.5 7-4 8-7l-1.5-1 1-1c1-1 2.004-2.5 3.5-5.5z";
      const GREENS = ["#34B44A", "#4ec46a", "#7ed492", "#2b8f3c"];
      const onBottomScroll = () => {
        if (confettiFired || matchMedia("(prefers-reduced-motion: reduce)").matches) return;
        const remaining = document.documentElement.scrollHeight - window.scrollY - window.innerHeight;
        // prewarm the module as the reader approaches the end
        if (remaining < 1600 && !confettiModule) {
          confettiModule = import("canvas-confetti");
        }
        if (remaining > 24 || !confettiModule) return;
        confettiFired = true;
        const mobile = matchMedia("(max-width: 760px)").matches;
        confettiModule.then(({ default: confetti }) => {
          const quill = confetti.shapeFromPath({ path: QUILL_PATH });
          const base = {
            shapes: [quill],
            colors: GREENS,
            scalar: mobile ? 1.2 : 1.7,
            ticks: mobile ? 160 : 240,
            gravity: 0.85,
            drift: 0.3,
            disableForReducedMotion: true,
          };
          const n = mobile ? 28 : 60;
          confetti({ ...base, particleCount: n, spread: 70, angle: 60, origin: { x: 0, y: 1 } });
          confetti({ ...base, particleCount: n, spread: 70, angle: 120, origin: { x: 1, y: 1 } });
          if (!mobile) {
            setTimeout(() => {
              confetti({ ...base, particleCount: 40, spread: 100, angle: 90, origin: { x: 0.5, y: 1 } });
            }, 250);
          }
        });
      };
      window.addEventListener("scroll", onBottomScroll, { passive: true });

      // GitHub star count (best-effort; silent on failure or rate limit).
      fetch("https://api.github.com/repos/Oleafly/Oleafly")
        .then((r) => (r.ok ? r.json() : null))
        .then((d) => {
          const n = d?.stargazers_count;
          const el = document.getElementById("stars-count");
          if (el && typeof n === "number") {
            el.textContent = n >= 1000 ? `${(n / 1000).toFixed(1)}k` : String(n);
          }
        })
        .catch(() => {});
    </script>
    <PlatformDownloadInit />
  </body>
</html>
