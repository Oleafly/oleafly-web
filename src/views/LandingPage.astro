      /* ===== Hero (product-first) ===== */
      .hero {
        position: relative;
        padding: 72px 0 48px;
        overflow: clip;
        text-align: left;
      }
      .hero-foreground {
        position: relative;
        z-index: 2;
      }
      .hero-glow,
      .hero-scene,
      .club-decor,
      .hero-copy {
        display: none;
      }
      .string-lights {
        position: absolute;
        top: 8px;
        left: 2%;
        right: 2%;
        height: 48px;
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        border-top: 3px solid var(--outline);
        padding-top: 0;
      }
      .bulb {
        width: 18px;
        height: 24px;
        border-radius: 50% 50% 42% 42%;
        margin-top: 6px;
        border: 2.5px solid var(--outline);
        box-shadow: 0 0 0 3px color-mix(in srgb, currentColor 35%, transparent);
        position: relative;
      }
      .bulb::before {
        content: "";
        position: absolute;
        top: -7px;
        left: 50%;
