</style>

<script>
  // ---------------------------------------------------------------- setup
  const root = document.querySelector<HTMLElement>("[data-heroapp]");
  if (root) {
    const $ = <T extends HTMLElement = HTMLElement>(sel: string) => root.querySelector<T>(sel)!;
    const viewport = $(".hv-viewport");
    const stage = $(".hv-stage");
    const prog = $("#hvProg");
    const cursor = $("#hvCursor");
    const ring = $("#hvRing");
    const tabs = Array.from(root.querySelectorAll<HTMLButtonElement>(".hv-tourbtn"));

    let zoomF = 1;
    const fit = () => {
      // zoom (not transform): fractional transforms blur sub-10px text in
      // Chromium; zoom re-lays-out natively at the final size.
      zoomF = viewport.clientWidth / 1080;
      (stage.style as CSSStyleDeclaration & { zoom: string }).zoom = String(zoomF);
    };
    fit();
    new ResizeObserver(fit).observe(viewport);

    // Project-scene handles
    const scene = $('.hv-scene[data-scene="project"]');
    const preview = scene.querySelector<HTMLElement>(".hv-preview")!;
    const codein = scene.querySelector<HTMLElement>(".hv-codein")!;
    const editorEl = scene.querySelector<HTMLElement>(".hv-editor")!;
    const zoomLabel = $("#hvZoom");
    const statusT = $("#hvStatusT");
    const suTitle = $("#hvSuTitle");
    const suCount = $("#hvSuCount");
    const suMeta = $("#hvSuMeta");
    const editKey = $("#hvEditKey");
    const caret = scene.querySelector<HTMLElement>(".hv-type-caret")!;
    const citeHot = $("#hvCiteHot");
    const citePop = $("#hvCitePop");
    const exportPdfRow = $("#hvExportPdf");
    const cpLabel = $("#hvCpLabel");
    const stItems = [$("#hvSt1"), $("#hvSt2"), $("#hvSt3")];
    const bars = [$("#hvBar1"), $("#hvBar2"), $("#hvBar3")];
    const treeEl = scene.querySelector<HTMLElement>(".hv-tree")!;
    const gripEl = $("#hvGrip");
    const tsplitEl = $("#hvTSplit");
    const zoomBtn = $("#hvZoomBtn");
    const zoomMenu = $("#hvZoomMenu");
    const fitRow = $("#hvFitWidth");

    // Assistant-scene handles
    const aiScene = $('.hv-scene[data-scene="assistant"]');
    const aiRunScroll = $("#hvAiRunScroll");
    const aiConnect = $("#hvAiConnect");
    const aiOpenAi = $("#hvOpenAiProvider");
    const aiKeyInput = $("#hvAiKeyInput");
    const aiSaveKey = $("#hvAiSaveKey");
    const aiInstructionsTab = $("#hvAiInstructionsTab");
    const aiDefaultModel = $("#hvAiDefaultModel");
    const aiModelSol = $("#hvAiModelSol");
    const aiCustomInstructions = $("#hvAiCustomInstructions");
    const aiInstructionValue = aiCustomInstructions.querySelector<HTMLElement>(".hv-instructions-value")!;
    const aiInstructionCaret = aiCustomInstructions.querySelector<HTMLElement>(".hv-type-caret")!;
    const aiSaveInstructions = $("#hvAiSaveInstructions");
    const aiCloseSettings = $("#hvAiCloseSettings");
    const aiFindPapers = $("#hvAiFindPapers");
    const aiUsage = $("#hvAiUsage");
    const aiApproveBib = $("#hvApproveBib");
    const aiAlwaysMain = $("#hvAlwaysMain");
    const aiOutlineBtn = $("#hvAiOutlineBtn");
    const aiOutlineRefs = $("#hvAiOutlineRefs");
    const aiPageNumber = $("#hvAiPageNumber");
    const aiComposerText = $("#hvAiComposerText");
    const aiStatusTime = aiScene.querySelector<HTMLElement>(".hv-ai-status-time")!;
    const aiPlanRows = Array.from(aiScene.querySelectorAll<HTMLElement>(".hv-ai-plan-row"));
    const aiStepEls = Array.from(aiScene.querySelectorAll<HTMLElement>("[data-ai-step]"));
    const aiResponseTexts = new Map(
      Array.from(aiScene.querySelectorAll<HTMLElement>(".hv-ai-response")).map((el) => [el, el.textContent ?? ""]),
    );
    let aiTypingTimers: number[] = [];

    // Organize-in-Spaces scene handles
    const homeSceneEl = $('.hv-scene[data-scene="home"]');
    const homeTargetBook = homeSceneEl.querySelector<HTMLElement>(".hv-space-book.is-target")!;
    const homeBookBookmark = $("#hvHomeBookBookmark");
    const homeFavFilter = $("#hvHomeFavFilter");
    const homeNewProject = $("#hvHomeNewProject");
    const homeAtsFilter = $("#hvAtsFilter");
    const homeSoftwareTemplate = $("#hvSoftwareTemplate");
    const homeNameInput = $("#hvHomeNameInput");
    const homeNameText = $("#hvHomeNameText");
    const homeLilac = $("#hvHomeLilac");
    const homeCreate = $("#hvHomeCreate");
    const homeCompileTitle = $("#hvHomeCompileTitle");
    const homeCompileCount = $("#hvHomeCompileCount");
    const homeCompileMeta = $("#hvHomeCompileMeta");
    const homeCompileLabel = homeSceneEl.querySelector<HTMLElement>(".hv-created-compile-label")!;

    // Create-Diagrams scene handles
    const diagramSceneEl = $('.hv-scene[data-scene="diagram"]');
    const diagramDraw = $("#hvDiagramDraw");
    const diagramCode = $("#hvDiagramCode");
    const diagramCompile = $("#hvDiagramCompile");
    const diagramCompileLabel = $("#hvDiagramCompileLabel");
    const diagramSave = $("#hvDiagramSave");
    const diagramSaveToProject = $("#hvDiagramSaveToProject");
    const diagramNewProject = $("#hvDiagramNewProject");
    const diagramAttention = $("#hvDiagramAttention");
    const diagramToastText = $("#hvDiagramToastText");
    const diagramBook = $("#hvDiagramBook");
    const diagramSourceView = $("#hvDiagramSourceView");
    const diagramRecompile = $("#hvDiagramRecompile");
    const diagramDownload = $("#hvDiagramDownload");
    const diagramInnerCode = $("#hvDiagramInnerCode");
    const diagramInnerCanvas = $("#hvDiagramInnerCanvas");
    const diagramNodeTarget = $("#hvDiagramNodeTarget");
    const diagramFontSize = $("#hvDiagramFontSize");
    const diagramFont16 = $("#hvDiagramFont16");
    const diagramPng = $("#hvDiagramPng");
    const diagramFilenameText = $("#hvDiagramFilenameText");
    const diagramFileSave = $("#hvDiagramFileSave");

    // editor scrollbar element (created here; styled globally)
    const sb = document.createElement("span");
    sb.className = "hv-sb";
    scene.querySelector(".hv-code")!.appendChild(sb);

    const reduced = matchMedia("(prefers-reduced-motion: reduce)").matches;

    // ------------------------------------------------------------- helpers
    const setAttr = (name: string, on: boolean) => {
      if (on) root.setAttribute(name, "");
      else {
        root.removeAttribute(name);
        if (name === "data-cursor") root.removeAttribute("data-cursor-pointer");
      }
    };

    /** Move the fake cursor to the center of an element (+optional offset). */
    let curX = 760;
    let curY = 400;
    let lastMove: [HTMLElement, number, number] | null = null;
    let cursorHoverTimer = 0;
    const moveTo = (el: HTMLElement, dx = 0, dy = 0, opts: { dur?: number; linear?: boolean } = {}) => {
      window.clearTimeout(cursorHoverTimer);
      setAttr("data-cursor-pointer", false);
      lastMove = [el, dx, dy];
      const r = el.getBoundingClientRect();
      const s = stage.getBoundingClientRect();
      const x = (r.left + r.width / 2 - s.left) / zoomF + dx;
      const y = (r.top + r.height / 2 - s.top) / zoomF + dy;
      const dist = Math.hypot(x - curX, y - curY);
      const dur = opts.dur ?? Math.min(900, Math.max(300, dist * 1.4));
      cursor.style.transitionDuration = `${dur}ms, 300ms`;
      cursor.style.transitionTimingFunction = opts.linear
        ? "linear, ease"
        : "cubic-bezier(0.25, 0.6, 0.2, 1), ease";
      cursor.style.transform = `translate(${x}px, ${y}px)`;
      curX = x;
      curY = y;
      cursorHoverTimer = window.setTimeout(() => {
        if (lastMove?.[0] === el) setAttr("data-cursor-pointer", true);
      }, Math.max(0, dur - 90));
    };
    const click = () => {
      window.clearTimeout(cursorHoverTimer);
      setAttr("data-cursor-pointer", true);
      ring.classList.remove("is-click");
      void ring.offsetWidth;
      ring.classList.add("is-click");
    };

    /** Small rAF number animators for the JS-driven layout vars. */
    const mkAnim = (apply: (v: number) => void, initial: number) => {
      let cur = initial;
      let raf = 0;
      apply(cur);
      const set = (v: number) => {
        cur = v;
        apply(v);
      };
      const anim = (to: number, dur: number) => {
        cancelAnimationFrame(raf);
        const from = cur;
        const t0 = performance.now();
        const step = (now: number) => {
          const p = Math.min(1, (now - t0) / dur);
          const e = 1 - (1 - p) * (1 - p); // ease-out
          set(from + (to - from) * e);
          if (p < 1) raf = requestAnimationFrame(step);
        };
        raf = requestAnimationFrame(step);
      };
      return { set, anim, get: () => cur };
    };
    // preview pane width
    const pvwA = mkAnim((v) => preview.style.setProperty("--pvw", String(v)), 517);
    // source-tree outer width (open/close slide keeps the inner column fixed)
    const treeA = mkAnim((v) => treeEl.style.setProperty("--treew", String(v)), 0);
    // source-tree inner width (follows during the drag-narrow beat)
    const treeInA = mkAnim((v) => treeEl.style.setProperty("--treeinw", String(v)), 241);
    // structure-section height (grip drag)
    const structA = mkAnim((v) => treeEl.style.setProperty("--structh", String(v)), 240);
    // rendered-page zoom (auto-fit + "Fit to width")
    const pgzA = mkAnim((v) => preview.style.setProperty("--pgz", v.toFixed(4)), 1.037);

    let lastScrollLine = 0;
    const scrollToLine = (n: number) => {
      lastScrollLine = n;
      const line = codein.querySelector<HTMLElement>(`[data-l="${n}"]`);
      const y = line ? line.offsetTop : 0;
      codein.style.transform = `translateY(${-y}px)`;
      const range = codein.scrollHeight - (codein.parentElement?.clientHeight ?? 0);
      const frac = range > 0 ? y / range : 0;
      sb.style.transform = `translateY(${frac * 340}px)`;
    };

    const setStage = (idx: number) => {
      // idx = how many startup tasks are complete (1 or 2)
      stItems.forEach((el, i) => {
        el.classList.remove("done", "run", "q");
        el.classList.add(i < idx ? "done" : i === idx ? "run" : "q");
      });
      bars.forEach((el, i) => {
        el.classList.remove("done", "run");
        if (i < idx) el.classList.add("done");
        else if (i === idx) el.classList.add("run");
      });
      suCount.textContent = `${idx}/3 done`;
      suMeta.textContent = idx === 1 ? "1 running · 1 queued" : "1 running · 0 queued";
      suTitle.textContent = idx === 1 ? "Compiling" : "Rendering PDF";
    };

    const placeCitePop = () => {
      const r = citeHot.getBoundingClientRect();
      const sc = scene.getBoundingClientRect();
      citePop.style.left = `${(r.left - sc.left) / zoomF - 24}px`;
      citePop.style.top = `${(r.bottom - sc.top) / zoomF + 6}px`;
    };

    const placeZoomMenu = () => {
      const r = zoomBtn.getBoundingClientRect();
      const pr = preview.getBoundingClientRect();
      zoomMenu.style.left = `${Math.max(6, (r.left - pr.left) / zoomF - 26)}px`;
    };

    // ------------------------------------------------------- project flow
    const KEY_FIX = "wilkinson2016";
