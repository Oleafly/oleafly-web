---
// Single GitHub pill for the navs: octocat mark + live star count.
// One link, no "Star" word, no external-link arrow (no-ext-icon).
const GITHUB = "https://github.com/Oleafly/Oleafly";
---

<a
  class="gh-star no-ext-icon"
  href={GITHUB}
  target="_blank"
  rel="noopener noreferrer"
  aria-label="Oleafly on GitHub"
>
  <svg width="15" height="15" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
    <path
      d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27s1.36.09 2 .27c1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8Z"
    ></path>
  </svg>
  <span class="gh-star-count" data-gh-star-count></span>
</a>

<style>
  a.gh-star {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    padding: 6px 11px;
    border-radius: 8px;
    border: 1px solid rgba(240, 246, 252, 0.12);
    background: #21262d;
    color: #e6edf3;
    font-size: 12.5px;
    font-weight: 600;
    text-decoration: none;
    flex-shrink: 0;
    font-variant-numeric: tabular-nums;
    transition: background-color 160ms ease, border-color 160ms ease;
  }
  a.gh-star:hover {
    background: #30363d;
    border-color: rgba(240, 246, 252, 0.22);
  }
  a.gh-star:hover::after {
    content: none;
    display: none;
  }
  .gh-star-count:empty {
    display: none;
  }
  @media (max-width: 760px) {
    a.gh-star {
      display: none;
    }
  }
</style>

<script>
  // Best-effort; silent on failure or rate limit.
  fetch("https://api.github.com/repos/Oleafly/Oleafly")
    .then((r) => (r.ok ? r.json() : null))
    .then((d) => {
      const n = d?.stargazers_count;
      if (typeof n !== "number") return;
      const text = n >= 1000 ? `${(n / 1000).toFixed(1)}k` : String(n);
      document.querySelectorAll("[data-gh-star-count]").forEach((el) => {
        el.textContent = text;
      });
    })
    .catch(() => {});
</script>
