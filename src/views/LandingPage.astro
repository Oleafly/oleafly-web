---

<html lang={meta.lang} dir={meta.dir}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={`https://oleafly.com${lp("/") === "/" ? "/" : lp("/")}`} />
    {landingAlternates.map((a) => (
      <link rel="alternate" hreflang={a.hreflang} href={a.href} />
    ))}
    <link rel="alternate" hreflang="x-default" href="https://oleafly.com/" />
    <link rel="icon" href="/favicon.png" type="image/png" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Oleafly" />
    <meta property="og:title" content="Oleafly: Write LaTeX like you write code" />
    <meta property="og:description" content={description} />
    <meta property="og:url" content="https://oleafly.com/" />
    <meta property="og:image" content="https://oleafly.com/og.png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="The Oleafly editor with LaTeX source and a live PDF preview" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="keywords" content="LaTeX editor, offline LaTeX editor, Overleaf alternative, LaTeX resume builder, ATS resume checker, AI LaTeX assistant, free LaTeX app Mac Windows Linux" />
    <meta name="twitter:title" content="Oleafly: Write LaTeX like you write code" />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content="https://oleafly.com/og.png" />

    <link rel="preload" as="image" href={HERO_EDITOR} fetchpriority="high" />
    <link rel="preload" href="/fonts/nunito-latin-wght.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/jbmono-var-latin.woff2" as="font" type="font/woff2" crossorigin />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    <Analytics />
    </head>

  <body class="club-landing" data-theme="light">
    <LocalePreference />
    <a class="skip" href="#main">{t(locale, "nav.skip")}</a>
    <ScrollProgress client:idle className="h-[5px] bg-[#2a2218]" />

    <!-- Soft fixed washes only; section doodles live on each section and reveal on scroll. -->
    <div class="page-washes" aria-hidden="true">
      <span class="doodle-wash doodle-wash-a"></span>
      <span class="doodle-wash doodle-wash-b"></span>
      <span class="doodle-wash doodle-wash-c"></span>
    </div>

    <!-- Shared PhD / research doodle symbols (referenced by section zones) -->
    <svg viewBox="0 0 64 64" class="doodle-sprite" aria-hidden="true" width="0" height="0" focusable="false">
      <defs>
        <symbol id="dd-scope" viewBox="0 0 56 72" fill="none">
          <rect x="18" y="48" width="28" height="8" rx="2" fill="#cce6ff" stroke="#2a2218" stroke-width="2.2"/>
          <path d="M10 64 H46" stroke="#2a2218" stroke-width="2.4" stroke-linecap="round"/>
          <path d="M28 48 V36" stroke="#2a2218" stroke-width="2.4" stroke-linecap="round"/>
          <circle cx="28" cy="22" r="12" fill="#fff9ed" stroke="#2a2218" stroke-width="2.4"/>
          <circle cx="28" cy="22" r="6" fill="#c8f5d8" stroke="#2a2218" stroke-width="1.8"/>
          <path d="M38 14 L46 6" stroke="#2a2218" stroke-width="2.4" stroke-linecap="round"/>
          <circle cx="48" cy="4" r="3.5" fill="#ffd0c8" stroke="#2a2218" stroke-width="1.8"/>
          <rect x="22" y="36" width="12" height="12" rx="2" fill="#ffe8a8" stroke="#2a2218" stroke-width="2"/>
        </symbol>
        <symbol id="dd-dna" viewBox="0 0 40 72" fill="none">
          <path d="M10 6 C22 14 18 26 10 34 C2 42 6 54 18 62" stroke="#5aa3e0" stroke-width="2.6" stroke-linecap="round"/>
          <path d="M30 6 C18 14 22 26 30 34 C38 42 34 54 22 62" stroke="#ef5a45" stroke-width="2.6" stroke-linecap="round"/>
          <path d="M12 12 H28 M10 22 H30 M12 32 H28 M10 42 H30 M12 52 H28" stroke="#2a2218" stroke-width="1.8" stroke-linecap="round" opacity="0.55"/>
          <circle cx="10" cy="6" r="3" fill="#5aa3e0" stroke="#2a2218" stroke-width="1.6"/>
          <circle cx="30" cy="6" r="3" fill="#ef5a45" stroke="#2a2218" stroke-width="1.6"/>
        </symbol>
        <symbol id="dd-atom" viewBox="0 0 64 64" fill="none">
          <circle cx="32" cy="32" r="5" fill="#f5c518" stroke="#2a2218" stroke-width="2"/>
          <ellipse cx="32" cy="32" rx="26" ry="10" stroke="#2a2218" stroke-width="2.2"/>
          <ellipse cx="32" cy="32" rx="26" ry="10" stroke="#5aa3e0" stroke-width="2.2" transform="rotate(60 32 32)"/>
          <ellipse cx="32" cy="32" rx="26" ry="10" stroke="#ef5a45" stroke-width="2.2" transform="rotate(-60 32 32)"/>
          <circle cx="58" cy="32" r="3.2" fill="#cce6ff" stroke="#2a2218" stroke-width="1.6"/>
        </symbol>
        <symbol id="dd-flask" viewBox="0 0 48 64" fill="none">
