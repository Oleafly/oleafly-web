      }
      .phil-title {
        color: var(--ink);
        background: none;
        -webkit-text-fill-color: unset;
      }
      .rotate-slot {
        display: inline-block;
        vertical-align: baseline;
      }
      .rotate-slot :global(div) {
        display: inline-block;
        padding: 0;
        overflow: visible;
        vertical-align: baseline;
      }
      :global(.h1-word) {
        font-size: inherit;
        font-weight: inherit;
        letter-spacing: inherit;
        line-height: inherit;
        white-space: normal;
      }
      @media (min-width: 640px) {
        :global(.h1-word) {
          white-space: nowrap;
        }
      }
      :global(.rotate-word) {
        font-weight: 900 !important;
        -webkit-text-fill-color: currentColor;
      }
      :global(.rotate-c1) { color: #ef5a45 !important; }
      :global(.rotate-c2) { color: #5aa3e0 !important; }
      :global(.rotate-c3) { color: #4ecf74 !important; }
      :global(.rotate-c4) { color: #9b6edc !important; }
      .lede {
        position: relative;
        max-width: 620px;
        margin: 0 0 32px;
        color: var(--muted);
        font-size: 16.5px;
        line-height: 1.6;
      }
      .hero-actions {
        position: relative;
        display: flex;
        justify-content: flex-start;
        align-items: center;
        gap: 12px;
        flex-wrap: wrap;
        margin-bottom: 56px;
      }
      .hero-actions :global(a[data-slot="button"]) {
