  .hv-space-dock { position:absolute; left:11px; top:258px; z-index:10; display:flex; flex-direction:column; align-items:center; gap:6px; padding:5px 4px; border:1px solid rgba(255,255,255,.1); border-radius:15px; background:rgba(255,255,255,.05); box-shadow:0 8px 30px -6px rgba(0,0,0,.5),inset 0 1px 0 rgba(255,255,255,.08); backdrop-filter:blur(12px) saturate(1.5); }
