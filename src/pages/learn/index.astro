---
import { getCollection } from "astro:content";
import SiteLayout from "../../layouts/SiteLayout.astro";
import { LEARN_CATEGORIES } from "../../data/learn-categories";
import { AsciiQuill } from "../../components/AsciiQuill";
import DownloadButton from "../../components/DownloadButton.astro";
import "../../styles/learn.css";

const RELEASES = "https://github.com/Oleafly/Oleafly/releases/latest";

const articles = await getCollection("learn");
const byCategory = new Map<string, typeof articles>();
for (const a of articles) {
  const list = byCategory.get(a.data.category) ?? [];
  list.push(a);
  byCategory.set(a.data.category, list);
}
for (const list of byCategory.values()) {
  list.sort((a, b) => a.data.order - b.data.order || a.data.title.localeCompare(b.data.title));
}

const total = articles.length;

const paths = [
  {
    href: "/learn/first-document/",
    kicker: "Track 1",
    title: "Compile your first PDF",
    desc: "Open the loop: a tiny article, one compile, and the three ideas that unlock most of the language.",
  },
  {
    href: "/learn/math-mode/",
    kicker: "Equation craft",
    title: "Math in the sentence or alone",
    desc: "Inline vs display, numbering, and the symbol card people keep next to the editor.",
  },
  {
    href: "/learn/oleafly-workflow/",
    kicker: "Local studio",
    title: "A week of writing in Oleafly",
    desc: "Templates, SyncTeX, citations, Git history, and optional AI with your own key on disk.",
  },
];
---

<SiteLayout
  title="Oleafly Learn: a local-first LaTeX course map | Oleafly"
  description="Oleafly Learn is a LaTeX course map for people who write on their own machines: compile loop, math, floats, citations, log literacy, TikZ, talks, and AI with your key."
  path="/learn/"
>
  <section class="learn-hero">
    <div class="container">
      <div class="learn-hero-grid">
        <div class="learn-hero-copy">
          <p class="eyebrow">Oleafly Learn</p>
          <h1>A LaTeX course map for people who own their files</h1>
          <p class="sub">
            Tracks you can walk in order or search by panic keyword. Written for the free
            {" "}
            <a href="/">Oleafly</a>
            {" "}
            app and any other local engine: first PDF through thesis chapters, citations, TikZ,
            log errors, and AI with your own key.
          </p>
          <div class="learn-stats" aria-label="Library size">
            <span class="learn-stat"><strong>{total}</strong> lessons</span>
            <span class="learn-stat"><strong>{LEARN_CATEGORIES.length}</strong> tracks</span>
            <span class="learn-stat"><strong>Paste-ready</strong> examples</span>
            <span class="learn-stat"><strong>Free</strong></span>
          </div>
          <div class="learn-search-wrap">
            <span class="learn-search-icon" aria-hidden="true">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <circle cx="11" cy="11" r="7"></circle>
                <path d="M20 20l-3.5-3.5"></path>
              </svg>
            </span>
            <label class="sr-only" for="learn-q">Search lessons</label>
            <input
              id="learn-q"
              class="learn-search"
              type="search"
              placeholder="Search lessons: align, bibtex, float, missing dollar..."
              autocomplete="off"
            />
          </div>
        </div>
        <div class="learn-hero-art" aria-hidden="true">
          <AsciiQuill client:load size={360} />
        </div>
      </div>

      <div class="learn-paths">
        {
          paths.map((p) => (
            <a class="learn-path" href={p.href}>
              <span class="path-kicker">{p.kicker}</span>
              <h3>{p.title}</h3>
              <p>{p.desc}</p>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <div class="container learn-layout">
    <nav class="learn-toc" aria-label="Course tracks">
      <p class="learn-toc-label">Tracks</p>
      {
        LEARN_CATEGORIES.map((cat) => {
          const count = byCategory.get(cat.id)?.length ?? 0;
          if (!count) return null;
          return (
            <a href={`#${cat.id}`} data-cat={cat.id}>
              {cat.label}
            </a>
          );
        })
      }
    </nav>

    <div class="learn-main">
      <div class="learn-empty" id="learn-empty" role="status">
        No lessons match that search. Try "align", "bibtex", or "float".
      </div>

      {
        LEARN_CATEGORIES.map((cat) => {
          const items = byCategory.get(cat.id) ?? [];
          if (!items.length) return null;
          const badgeClass =
            cat.badge === "depth"
              ? "learn-badge depth"
              : cat.badge === "oleafly"
                ? "learn-badge oleafly"
                : cat.badge === "essentials"
                  ? "learn-badge"
                  : "learn-badge";
          const badgeLabel =
            cat.badge === "depth"
              ? "Depth"
              : cat.badge === "oleafly"
                ? "Oleafly"
                : cat.badge === "essentials"
                  ? "Core"
                  : null;
          return (
            <section class="learn-section" id={cat.id} data-section={cat.id}>
              <div class="learn-section-head">
                <h2>{cat.label}</h2>
                {badgeLabel && <span class={badgeClass}>{badgeLabel}</span>}
              </div>
              <p class="learn-section-desc">{cat.description}</p>
              <div class="learn-links">
                {items.map((a) => (
                  <a
                    class="learn-link"
                    href={`/learn/${a.id}/`}
                    data-search={`${a.data.title} ${a.data.description} ${a.data.tags.join(" ")} ${cat.label}`.toLowerCase()}
                  >
                    <span class="dot" aria-hidden="true" />
                    <span class="meta">
                      <span class="title">{a.data.title}</span>
                      <span class="desc">{a.data.description}</span>
                      <span class="level">{a.data.level}</span>
                    </span>
                  </a>
                ))}
              </div>
            </section>
          );
        })
      }

      <div class="learn-cta">
        <h2>Write LaTeX locally with Oleafly</h2>
        <p>
          Free and open source. Bundled compiler, SyncTeX, real Git history, templates,
          and optional AI with your own key. No account required.
        </p>
        <div class="learn-cta-actions">
          <DownloadButton
            href={RELEASES}
            size="lg"
            label="Download Oleafly"
            labelTemplate="Download for {os}"
          />
          <a class="btn btn-ghost btn-lg" href="/tools/">Free browser tools</a>
          <a class="btn btn-ghost btn-lg" href="/templates/">Templates</a>
        </div>
      </div>
    </div>
  </div>

  <style>
    .sr-only {
      position: absolute;
      width: 1px;
      height: 1px;
      padding: 0;
      margin: -1px;
      overflow: hidden;
      clip: rect(0, 0, 0, 0);
      white-space: nowrap;
      border: 0;
    }
  </style>

  <script>
    const input = document.getElementById("learn-q") as HTMLInputElement | null;
    const empty = document.getElementById("learn-empty");
    const links = Array.from(document.querySelectorAll<HTMLElement>(".learn-link"));
    const sections = Array.from(document.querySelectorAll<HTMLElement>(".learn-section[data-section]"));
    const tocLinks = Array.from(document.querySelectorAll<HTMLAnchorElement>(".learn-toc a[data-cat]"));

    function applyFilter() {
      const q = (input?.value ?? "").trim().toLowerCase();
      let visible = 0;
      for (const link of links) {
        const hay = link.dataset.search ?? "";
        const show = !q || hay.includes(q);
        link.style.display = show ? "" : "none";
        if (show) visible++;
      }
      for (const section of sections) {
        const any = Array.from(section.querySelectorAll<HTMLElement>(".learn-link")).some(
          (el) => el.style.display !== "none",
        );
        section.style.display = any ? "" : "none";
      }
      empty?.classList.toggle("is-visible", visible === 0);
    }

    input?.addEventListener("input", applyFilter);

    // Active TOC highlight on scroll
    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;
          const id = (entry.target as HTMLElement).id;
          for (const a of tocLinks) {
            a.classList.toggle("is-active", a.dataset.cat === id);
          }
        }
      },
      { rootMargin: "-20% 0px -70% 0px", threshold: 0 },
    );
    for (const section of sections) observer.observe(section);
  </script>
</SiteLayout>
