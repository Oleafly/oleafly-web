      root.dataset.scene = "project";
      setAttr("data-compiled", true);
      zoomLabel.textContent = "105%";
      cpLabel.textContent = "Recompile";
      clearAiTyping();
      for (const a of [
        "data-ai-compiling",
        "data-cursor",
        "data-recompiling",
        "data-toast",
        "data-tree",
        "data-fixed",
      ]) root.removeAttribute(a);
      root.dataset.pop = "";
      setAiPane("pdf");
      cpLabel.textContent = "Recompile";
      aiScene.dataset.chat = "connect";
      aiScene.dataset.provider = "closed";
      aiScene.dataset.settingsTab = "providers";
      aiScene.dataset.aiCompile = "done";
      for (const a of [
        "data-settings",
        "data-key",
        "data-model-menu",
        "data-model-selected",
        "data-instructions-filled",
        "data-instructions-saved",
        "data-ai-pop",
        "data-approval",
        "data-outline",
        "data-fixed",
      ]) aiScene.removeAttribute(a);
      aiInstructionValue.textContent = "";
      aiInstructionCaret.classList.remove("is-typing");
      aiComposerText.textContent = "Ask AI to help with your document...";
      aiComposerText.classList.remove("is-user-text");
      aiModelSol.classList.remove("is-hover");
      aiOutlineRefs.classList.remove("is-hover");
      aiPageNumber.textContent = "1";
      aiStatusTime.textContent = "4.3s";
      setAiStep(0);
      setAiPlan(0);
      aiRunScroll.scrollTop = 0;
      lastMove = null;
      cursor.style.transitionDuration = "0ms, 300ms";
      cursor.style.transform = "translate(760px, 400px)";
      curX = 760;
      curY = 400;
    };

    const resetHome = () => {
      window.clearTimeout(cursorHoverTimer);
      setAttr("data-cursor", false);
      homeSceneEl.dataset.homeState = "library";
      homeSceneEl.dataset.homeCompile = "compile";
      homeSceneEl.removeAttribute("data-home-hover");
      homeSceneEl.removeAttribute("data-home-bookmark-pulse");
      homeSceneEl.removeAttribute("data-home-filter");
      homeSceneEl.removeAttribute("data-home-new-hover");
      homeSceneEl.removeAttribute("data-home-ats");
      homeSceneEl.removeAttribute("data-home-template-hover");
      homeSceneEl.removeAttribute("data-home-name-typing");
      homeSceneEl.removeAttribute("data-home-color-hover");
      homeSceneEl.removeAttribute("data-home-color");
      homeBookBookmark.classList.remove("is-on");
      homeNameText.textContent = "Software Engineer Resume";
      homeCompileTitle.textContent = "Compiling";
      homeCompileCount.textContent = "1/3 done";
      homeCompileMeta.textContent = "1 running · 1 queued";
      homeCompileLabel.textContent = "Compile";
      lastMove = null;
      cursor.style.transitionDuration = "0ms, 300ms";
      cursor.style.transform = "translate(760px, 400px)";
      curX = 760;
      curY = 400;
    };

    const resetDiagram = () => {
      window.clearTimeout(cursorHoverTimer);
      setAttr("data-cursor", false);
      setDiagramState("draw");
      diagramCompileLabel.textContent = "Compile";
      diagramToastText.textContent = "Saved to figures/diagram.png";
      diagramFontSize.textContent = "11pt　⌄";
      diagramFilenameText.textContent = DIAGRAM_FILENAME;
      diagramSceneEl.style.removeProperty("--dgm-label-size");
      lastMove = null;
      cursor.style.transitionDuration = "0ms, 300ms";
      cursor.style.transform = "translate(760px, 400px)";
      curX = 760;
      curY = 400;
    };

    /** Motionless end-state for prefers-reduced-motion viewers. */
    const applyTableau = () => {
      resetProject();
      setAttr("data-compiled", true);
      setAttr("data-tree", true);
      setAttr("data-fixed", true);
      cpLabel.textContent = "Recompile";
      zoomLabel.textContent = "96%";
      pvwA.set(397);
      treeA.set(241);
      pgzA.set(0.818);
      editKey.textContent = KEY_FIX;
    };

    /** Motionless proof state for reduced-motion assistant viewers. */
    const applyAssistantTableau = () => {
      resetAssistant();
      root.dataset.scene = "assistant";
      aiScene.dataset.provider = "ready";
      aiScene.dataset.settingsTab = "instructions";
      aiScene.dataset.chat = "done";
      aiScene.dataset.aiCompile = "done";
      aiScene.setAttribute("data-model-selected", "");
      aiScene.setAttribute("data-instructions-filled", "");
      aiScene.setAttribute("data-fixed", "");
      aiInstructionValue.textContent = AI_INSTRUCTIONS;
      aiStatusTime.textContent = "3.0s";
      setAiStep(10.1);
      setAiPlan(6);
      setAiPane("references");
      aiPageNumber.textContent = "2";
    };

    const applyHomeTableau = () => {
      resetHome();
      homeNameText.textContent = HOME_PROJECT_NAME;
      homeSceneEl.dataset.homeColor = "lilac";
      homeSceneEl.dataset.homeState = "created";
      homeSceneEl.dataset.homeCompile = "done";
      homeCompileLabel.textContent = "Recompile";
    };

    const applyDiagramTableau = () => {
      resetDiagram();
      diagramFontSize.textContent = "16pt　⌄";
      diagramSceneEl.style.setProperty("--dgm-label-size", "16px");
      diagramToastText.textContent = "PNG saved · diagram.png";
      setDiagramState("exported");
    };

    // --------------------------------------------------------- scene loop
    const order = ["project", "assistant", "cite", "diagram", "home"];
    let sceneIdx = 0;
    let sceneStart = performance.now();
    let stepIdx = 0;
    let rafId = 0;
    let running = false;

    const setScene = (idx: number) => {
      sceneIdx = idx;
      sceneStart = performance.now();
      stepIdx = 0;
      root.dataset.scene = order[idx];
      root.dataset.pop = "";
      root.removeAttribute("data-ai-compiling");
      for (const tab of tabs) tab.setAttribute("aria-selected", String(tab.dataset.goto === order[idx]));
      if (order[idx] === "project") {
        if (reduced) applyTableau();
        else resetProject();
      } else if (order[idx] === "assistant") {
        if (reduced) applyAssistantTableau();
        else resetAssistant();
      } else if (order[idx] === "home") {
        if (reduced) applyHomeTableau();
        else resetHome();
      } else if (order[idx] === "diagram") {
        if (reduced) applyDiagramTableau();
        else resetDiagram();
      } else {
        root.removeAttribute("data-ai-pane");
        setAttr("data-cursor", false);
      }
    };

    // Dev aid: ?hvt=<ms>&hvfreeze=1 fast-forwards then freezes for screenshots.
    // Assistant states use ?hvscene=assistant&hvat=<ms>&hvfreeze=1.
    const devParams = new URLSearchParams(location.search);
    const freeze = devParams.get("hvfreeze") != null;

    const tick = (now: number) => {
      const el = now - sceneStart;
      const activeScene = order[sceneIdx];
      const activeSteps = activeScene === "project" ? steps : activeScene === "assistant" ? aiSteps : activeScene === "home" ? homeSteps : activeScene === "diagram" ? diagramSteps : [];
      const dur = activeScene === "project" ? PROJECT_DUR : activeScene === "assistant" ? ASSISTANT_DUR : activeScene === "home" ? HOME_DUR : activeScene === "diagram" ? DIAGRAM_DUR : STATIC_DUR;
      if (activeSteps.length) {
        while (stepIdx < activeSteps.length && activeSteps[stepIdx].t <= el) {
          activeSteps[stepIdx].run();
          stepIdx++;
        }
      }
      const local = Math.min(1, el / dur);
      prog.style.width = `${((sceneIdx + local) / order.length) * 100}%`;
      if (freeze && el > 400) {
        // settle layout-dependent bits after panel transitions, then halt
        running = false;
        setTimeout(() => {
          root.classList.add("hv-freeze");
          if (lastScrollLine) scrollToLine(lastScrollLine);
          if (root.dataset.pop === "cite") placeCitePop();
          if (root.dataset.pop === "zoom") placeZoomMenu();
          if (activeScene === "assistant") aiRunScroll.scrollTop = aiRunScroll.scrollHeight;
          if (lastMove) moveTo(lastMove[0], lastMove[1], lastMove[2], { dur: 0 });
        }, 400);
        return;
      }
      if (el >= dur) setScene((sceneIdx + 1) % order.length);
      rafId = requestAnimationFrame(tick);
    };

    const start = () => {
      if (running || reduced) return;
      running = true;
      rafId = requestAnimationFrame(tick);
    };
    const stop = () => {
      running = false;
      cancelAnimationFrame(rafId);
    };

    // Tab clicks jump straight to a scene (and restart its flow).
    root.addEventListener("pointerdown", (e) => {
      const btn = (e.target as HTMLElement).closest<HTMLElement>("[data-goto]");
      if (btn?.dataset.goto) {
        const idx = order.indexOf(btn.dataset.goto);
        if (idx >= 0) setScene(idx);
      }
    });

    if (reduced) {
      // Static tableau: compiled project with the tree open, refs resolved.
      applyTableau();
    } else {
      resetProject();
      // Dev aids: ?hvt=<ms> fast-forwards the project flow; ?hvscene=<id> jumps
      // straight to a scene.
      const jump = devParams.get("hvscene");
      let pendingSkip = Number(
        jump === "assistant"
          ? devParams.get("hvat") ?? devParams.get("hvt") ?? 0
          : jump === "home"
            ? devParams.get("hvhome") ?? devParams.get("hvt") ?? 0
            : jump === "diagram"
              ? devParams.get("hvdiagram") ?? devParams.get("hvt") ?? 0
            : devParams.get("hvt") ?? 0,
      ) || 0;
      if (jump && order.includes(jump)) setScene(order.indexOf(jump));
      // Pause the tour while off screen.
      const io = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (entry.isIntersecting) {
              if (!running) {
                stepIdx = 0;
                if (order[sceneIdx] === "project") resetProject();
                if (order[sceneIdx] === "assistant") resetAssistant();
                if (order[sceneIdx] === "home") resetHome();
                if (order[sceneIdx] === "diagram") resetDiagram();
                sceneStart = performance.now() - pendingSkip;
                pendingSkip = 0;
                start();
              }
            } else stop();
          }
        },
        { threshold: 0.15 },
      );
      io.observe(root);
    }
  }
</script>
