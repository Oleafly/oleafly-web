        padding: 6px 12px;
      }
      .btn-lg {
        font-size: 14px;
        padding: 10px 18px;
      }
      .btn-primary {
        background: var(--brand);
        color: #fffaf5;
        border: 3px solid var(--outline);
        font-family: var(--font-ui);
        font-weight: 800;
        letter-spacing: 0.01em;
        border-radius: 999px;
        box-shadow: 0 5px 0 var(--outline);
      }
      .btn-primary:hover {
        background: #ff6d58;
