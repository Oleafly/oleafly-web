  .hv-sec { text-align: center; font-size: 7px; margin: 10px 0 4.5px; letter-spacing: 0.02em; }
  .hv-sec span { font-size: 5.6px; letter-spacing: 0.05em; }
  .hv-fcap { font-size: 5.8px; line-height: 1.4; color: #1c1c1c; margin: 3px 0 7px; text-align: justify; }
  .hv-eq { font-size: 7px; text-align: center; margin: 9px 0 5px; position: relative; }
  .hv-eq .hv-eqn { position: absolute; right: 0; top: 0; }
