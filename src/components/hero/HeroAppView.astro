  .hv-space-shelf { position:absolute; inset:34px 0 0; z-index:2; display:grid; grid-template-columns:repeat(4,128px); grid-auto-rows:202px; column-gap:66px; row-gap:40px; align-content:start; padding:34px 0 56px 183px; overflow:hidden; }
  .hv-space-book { width:128px; height:202px; color:#a4a4a4; transition:transform .18s,opacity .2s; }
