---
// oleafly.com landing page.
//
// Design system: classroom club energy (warm cream walls, chalkboard green,
// multicolor party accents, string lights, playful Nunito). Light-only.
// Structure restyled in place — product content unchanged.
import { Marquee } from "../components/magicui/marquee";
import PlatformDownloadInit from "../components/PlatformDownloadInit.astro";
import Analytics from "../components/Analytics.astro";
import SocialLinks from "../components/SocialLinks.astro";
import LanguageSwitcher from "../components/LanguageSwitcher.astro";
import LocalePreference from "../components/LocalePreference.astro";
import { WordRotate } from "../components/magicui/word-rotate";
import { AnimatedCircularProgressBar } from "../components/magicui/animated-circular-progress-bar";
import { ScrollProgress } from "../components/magicui/scroll-progress";
import { ProjectFileTree } from "../components/ProjectFileTree";
import { BentoSection } from "../components/BentoSection";
import { PhilosophyReveal } from "../components/PhilosophyReveal";
import CodeComparison from "../components/CodeComparison.astro";
import "../styles/fonts.css";
import "../styles/magicui.css";
import "../styles/external-links.css";
import { DEFAULT_LOCALE, LOCALE_META, type Locale } from "../i18n/locales";
import { hreflangAlternates, localePath } from "../i18n/paths";
import { t } from "../i18n/t";

interface Props {
  locale?: Locale;
}
const locale: Locale = Astro.props.locale ?? DEFAULT_LOCALE;
const meta = LOCALE_META[locale];
const lp = (path: string) => localePath(locale, path);
const landingAlternates = hreflangAlternates("/");

const GITHUB = "https://github.com/Oleafly/Oleafly";
const RELEASES = `${GITHUB}/releases/latest`;

// Product screenshots from oleafly-assets CDN. Prefer *-light.png on this
// cream landing so dark UI captures don't clash with the journal theme.
const CDN_SHOT = "https://cdn.oleafly.com/images/screenshots/desktop";
const HERO_EDITOR = `${CDN_SHOT}/hero-editor-light.png`;
const PROJECT_TEMPLATES = `${CDN_SHOT}/project-templates-light.png`;
const PREFLIGHT_ATS = `${CDN_SHOT}/preflight-ats-light.png`;
// No light capture yet — single dark variant on CDN.
const GIT_DIFF = `${CDN_SHOT}/git-diff.png`;
const HERO_CLUB_CLASSROOM =
  "https://cdn.oleafly.com/images/web/hero-club-classroom.jpg";

// The craft/test-counts section is parked for now; flip to true to restore it.
const SHOW_CRAFT = true;

const title = t(locale, "landing.title");
const description = t(locale, "landing.description");

// Apple and Linux marks from simple-icons; Windows is the classic four panes.
