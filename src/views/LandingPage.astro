      .banner-letter.c1 { color: #f5c518; }
      .banner-letter.c2 { color: #ef5a45; }
      .banner-letter.c3 { color: #4ecf74; }
      .banner-letter.c4 { color: #5aa3e0; }
      .banner-letter.c5 { color: #9b6edc; }
      .banner-letter.c6 { color: #f29b3a; }
      .banner-club {
        margin-left: 10px;
        font-weight: 900;
        font-size: 0.78em;
