---
import { getCollection } from "astro:content";
import BlogPostPage from "../../views/BlogPostPage.astro";
import { DEFAULT_LOCALE } from "../../i18n/locales";
import { entriesForLocale, entrySlug } from "../../i18n/content";

export async function getStaticPaths() {
  const all = await getCollection("blog");
  const { entries: posts } = entriesForLocale(all, DEFAULT_LOCALE);
  return posts.map((post) => ({
    params: { slug: entrySlug(post.id) },
    props: { post },
  }));
}

const { post } = Astro.props;
---
<BlogPostPage post={post} locale={DEFAULT_LOCALE} isFallback={false} />
