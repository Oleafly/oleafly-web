---
import { getCollection } from "astro:content";
import LearnLessonPage from "../../views/LearnLessonPage.astro";
import { DEFAULT_LOCALE } from "../../i18n/locales";
import { entriesForLocale, entrySlug } from "../../i18n/content";

export async function getStaticPaths() {
  const all = await getCollection("learn");
  const { entries: articles } = entriesForLocale(all, DEFAULT_LOCALE);
  const byCat = new Map<string, typeof articles>();
  for (const a of articles) {
    const list = byCat.get(a.data.category) ?? [];
    list.push(a);
    byCat.set(a.data.category, list);
  }
  for (const list of byCat.values()) {
    list.sort((a, b) => a.data.order - b.data.order || a.data.title.localeCompare(b.data.title));
  }
  return articles.map((article) => {
    const siblings = byCat.get(article.data.category) ?? [];
    const idx = siblings.findIndex((s) => s.id === article.id);
    const prev = idx > 0 ? siblings[idx - 1] : null;
    const next = idx >= 0 && idx < siblings.length - 1 ? siblings[idx + 1] : null;
    return {
      params: { slug: entrySlug(article.id) },
      props: { article, prev, next },
    };
  });
}

const { article, prev, next } = Astro.props;
---
<LearnLessonPage
  article={article}
  prev={prev}
  next={next}
  locale={DEFAULT_LOCALE}
  isFallback={false}
/>
