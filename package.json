{
  "name": "oleafly.com",
  "type": "module",
  "private": true,
  "description": "oleafly.com — landing page and documentation site for Oleafly, built with Astro + Starlight, deployed on Cloudflare Pages.",
  "scripts": {
    "dev": "astro dev",
    "build": "node scripts/fetch-remote-data.mjs && node scripts/build-llms-full.mjs && astro build",
    "preview": "astro preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "i18n:coverage": "node scripts/i18n-coverage.mjs",
    "i18n:coverage:md": "node scripts/i18n-coverage.mjs --markdown --write-readme",
    "i18n:translate:ui": "node scripts/translate-ui-gtx.mjs",
    "i18n:translate:content": "node scripts/translate-site-content.mjs",
    "deploy": "astro build && wrangler pages deploy dist --project-name=oleafly"
  },
  "dependencies": {
    "@astrojs/react": "^6.0.1",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/starlight": "^0.41.3",
    "@codemirror/commands": "^6.10.4",
    "@codemirror/language": "^6.12.4",
    "@codemirror/legacy-modes": "^6.5.3",
    "@codemirror/state": "^6.7.1",
    "@codemirror/view": "^6.43.6",
    "@lezer/highlight": "^1.2.3",
    "@radix-ui/react-accordion": "^1.2.16",
    "@radix-ui/react-slot": "^1.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.1.2",
    "canvas-confetti": "^1.9.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "codemirror": "^6.0.2",
    "katex": "^0.18.1",
    "kokoro-js": "^1.2.1",
    "lucide-react": "^1.25.0",
    "motion": "^12.42.2",
    "posthog-js": "^1.407.2",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "reading-time": "^1.5.0",
    "rough-notation": "^0.5.1",
    "sharp": "^0.33.5",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/canvas-confetti": "^1.9.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "google-translate-api-x": "^10.7.3",
    "shiki": "^4.3.1",
    "vitest": "^3.2.7",
    "wrangler": "^4.112.0"
  }
}
