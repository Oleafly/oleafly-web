  .hv-space-cover { position:relative; width:128px; height:169px; overflow:hidden; background:var(--book); color:#17233a; border-radius:5px 7px 7px 5px; box-shadow:inset 7px 0 7px -5px rgba(0,0,0,.35),inset -1px 0 2px rgba(255,255,255,.45),0 4px 0 -1px color-mix(in srgb,var(--book),#6f6f4a 35%),0 7px 0 -3px color-mix(in srgb,var(--book),#222 25%),0 11px 18px rgba(0,0,0,.32); }
  .hv-space-cover::before { content:""; position:absolute; left:8px; top:0; bottom:0; z-index:3; width:1px; background:rgba(0,0,0,.13); }
