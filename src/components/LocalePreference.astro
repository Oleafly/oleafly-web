---
/**
 * Soft locale preference (no geo hard-lock):
 * - Saved switcher choice → soft-redirect bare `/` once per session
 * - Else browser languages → one-time on-demand banner
 * Deep links and shared URLs are never rewritten.
 */
import { LOCALES, LOCALE_META } from "../i18n/locales";

const localeOptions = LOCALES.map((code) => ({
  code,
  lang: LOCALE_META[code].lang,
  nativeLabel: LOCALE_META[code].nativeLabel,
  flag: LOCALE_META[code].flag,
  flagIso: LOCALE_META[code].flagIso,
}));
---

<script>
  import { initLocalePreference } from "./locale-preference-client";

  const options = JSON.parse(
    document.getElementById("oleafly-locale-options")?.textContent || "[]",
  ) as Array<{
    code: string;
    lang: string;
    nativeLabel: string;
    flag: string;
    flagIso?: string;
  }>;

  initLocalePreference(options);
</script>

<script
  type="application/json"
  id="oleafly-locale-options"
  set:html={JSON.stringify(localeOptions)}
/>
