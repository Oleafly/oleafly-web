    <style>
      /* ===== Tokens: cartoon classroom (YC Robotics Club palette) ===== */
      :root {
        color-scheme: light;
        /* Illustration palette — saturated, flat, outlined */
        --brand: #ef5a45;
        --brand-hover: #dc4632;
        --brand-text: #d44532;
        --accent: #f5c518;
        --accent-soft: rgba(245, 197, 24, 0.35);
        --club-teal: #4db8b0;
        --club-blue: #5aa3e0;
        --club-green: #4ecf74;
        --club-purple: #9b6edc;
        --club-orange: #f29b3a;
        --club-pink: #ef6b8a;
        --chalk: #2a5644;
        --chalk-soft: #356b54;
        --wood: #c9955c;
        --wood-dark: #a6743f;
        /* Warm cream only — no slate floor band */
        --floor: #ebe0c8;
        --floor-deep: #e4d6b8;
        --wall: #f3e8d0;
        --bg: #f3e8d0;
        --bg-deep: #e8d9b8;
        --surface: #fff8ec;
        --surface-2: #f5e8cf;
        --surface-hover: #ffe8a3;
        --text: #2a2218;
        --ink: #1a1410;
        --outline: #2a2218;
        --muted: #6a5d4c;
        --line: rgba(42, 34, 24, 0.16);
        --line-strong: rgba(42, 34, 24, 0.28);
        --bronze: #c9955c;
        --bronze-bright: #dcb07a;
        --green: #4ecf74;
        --red: #ef5a45;
        --radius-sm: 10px;
        --radius-md: 14px;
        --radius-lg: 22px;
        /* Comic hard shadows (illustration style) */
        --shadow-popup: 3px 4px 0 var(--outline);
        --shadow-modal: 6px 8px 0 rgba(42, 34, 24, 0.18), 10px 14px 28px rgba(42, 34, 24, 0.12);
        --font: "Nunito", "Avenir Next", "Segoe UI", system-ui, sans-serif;
        --font-ui: "Nunito", system-ui, sans-serif;
        --mono: "JetBrains Mono", ui-monospace, SFMono-Regular, Menlo, monospace;
      }

      * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
      }
      html {
        scroll-behavior: smooth;
        scroll-padding-top: 76px;
        overflow-x: clip;
      }
      body {
        /* Even warm cream — no hard wall/floor color break */
        position: relative;
        background:
          radial-gradient(ellipse 90% 50% at 50% -5%, #fff6e4 0%, transparent 55%),
          linear-gradient(180deg, #f7edd8 0%, var(--wall) 40%, var(--bg-deep) 100%);
        background-color: var(--wall);
        /* fixed attachment is a major mobile jank source — desktop only */
        background-attachment: scroll;
        color: var(--text);
        font-family: var(--font);
        font-size: 16.5px;
        line-height: 1.5;
        font-weight: 600;
        -webkit-font-smoothing: antialiased;
        text-rendering: optimizeLegibility;
        overflow-x: clip;
        max-width: 100vw;
      }
      @media (min-width: 961px) {
        body {
          background-attachment: fixed;
        }
      }
      body::before {
        display: none;
      }
      body > * {
        position: relative;
        z-index: 1;
      }

      /* ===== Section doodles (reveal on scroll; never block UI) ===== */
      .page-washes {
        position: fixed !important;
        inset: 0;
        z-index: 0 !important;
        pointer-events: none;
        overflow: hidden;
      }
      .doodle-sprite {
        position: absolute;
        width: 0;
        height: 0;
        overflow: hidden;
      }
      .doodle-wash {
        position: absolute;
        border-radius: 50%;
        filter: blur(56px);
        opacity: 0.4;
      }
      .doodle-wash-a {
        width: min(380px, 36vw);
        height: min(380px, 36vw);
        top: 8vh;
        left: -6vw;
        background: radial-gradient(circle, #ffe8a8 0%, transparent 70%);
      }
      .doodle-wash-b {
        width: min(340px, 32vw);
        height: min(340px, 32vw);
        top: 42vh;
        right: -8vw;
        background: radial-gradient(circle, #cce6ff 0%, transparent 70%);
      }
      .doodle-wash-c {
        width: min(320px, 30vw);
        height: min(320px, 30vw);
        bottom: 6vh;
        left: -4vw;
        background: radial-gradient(circle, #c8f5d8 0%, transparent 70%);
      }
      .section-doodles {
        position: absolute;
        inset: 0;
        z-index: 1;
        pointer-events: none;
        overflow: hidden; /* hard play boundary — bounce inside */
        user-select: none;
        touch-action: none;
      }
      .section-doodles .doodle-wrap {
        position: absolute;
        display: block;
        width: 56px;
        height: 56px;
        pointer-events: auto;
        opacity: 0;
        z-index: 1;
        cursor: grab;
        touch-action: none;
        will-change: left, top, transform;
        transition: opacity 0.45s ease;
      }
      .section-doodles .doodle-wrap.is-dragging {
        z-index: 30;
        cursor: grabbing;
        opacity: 1 !important;
      }
      .section-doodles .doodle-wrap.is-dragging .doodle {
        opacity: 1;
        filter: drop-shadow(3px 8px 0 rgba(42, 34, 24, 0.16));
        transform: scale(1.12) rotate(var(--r, 0deg));
      }
      .section-doodles .doodle {
        display: block;
        width: 100%;
        height: 100%;
        overflow: visible;
        transform: rotate(var(--r, 0deg));
        transform-origin: center center;
        pointer-events: none;
        opacity: 0.88;
        transition: filter 0.2s ease, opacity 0.2s ease, transform 0.2s ease;
      }
      .section-doodles .doodle use {
        width: 100%;
        height: 100%;
      }
      .section-doodles.is-visible .doodle-wrap {
        opacity: 1;
      }
      .section-doodles.is-visible .doodle-wrap:nth-child(1) { transition-delay: 0.04s; }
      .section-doodles.is-visible .doodle-wrap:nth-child(2) { transition-delay: 0.1s; }
      .section-doodles.is-visible .doodle-wrap:nth-child(3) { transition-delay: 0.16s; }
      .section-doodles.is-visible .doodle-wrap:nth-child(4) { transition-delay: 0.22s; }
      .section-doodles.is-visible .doodle-wrap:nth-child(5) { transition-delay: 0.28s; }
      .section-doodles.is-visible .doodle-wrap:nth-child(6) { transition-delay: 0.34s; }
      .section-doodles.is-visible .doodle-wrap:nth-child(7) { transition-delay: 0.4s; }
      .section-doodles.is-visible .doodle-wrap:nth-child(8) { transition-delay: 0.46s; }
      /* Playable physics owns motion — no CSS float/magnetic transforms */
      .section-doodles.is-playable .doodle-wrap {
        transition: opacity 0.4s ease;
        animation: none !important;
      }

      /*
        Hero gutters — 8 icons only, outside the ~1080 content column.
        Left/right columns with generous vertical gaps (not a dense ring).
      */
      .section-doodles--hero .doodle-wrap { width: 58px; height: 58px; }
      .d-h1 { top: 10%;  left: max(18px, calc(50% - 620px)); width: 52px; height: 52px; }
      .d-h2 { top: 12%;  right: max(22px, calc(50% - 620px)); width: 58px; height: 58px; }
      .d-h3 { top: 34%;  left: max(28px, calc(50% - 640px)); width: 36px; height: 36px; }
      .d-h4 { top: 36%;  right: max(30px, calc(50% - 640px)); width: 44px; height: 44px; }
      .d-h5 { top: 58%;  left: max(16px, calc(50% - 610px)); width: 54px; height: 54px; }
      .d-h6 { top: 56%;  right: max(18px, calc(50% - 615px)); width: 50px; height: 50px; }
      .d-h7 { top: 80%;  left: max(32px, calc(50% - 630px)); width: 56px; height: 56px; }
      .d-h8 { top: 78%;  right: max(26px, calc(50% - 625px)); width: 42px; height: 42px; }

      /* Features — 4 airy corners */
      .d-f1 { top: 14%; left: max(16px, calc(50% - 600px)); width: 48px; height: 48px; }
      .d-f2 { top: 20%; right: max(18px, calc(50% - 600px)); width: 50px; height: 50px; }
      .d-f3 { top: 74%; left: max(22px, calc(50% - 590px)); width: 40px; height: 40px; }
      .d-f4 { top: 78%; right: max(16px, calc(50% - 590px)); width: 54px; height: 54px; }

      /* On-disk */
      .d-d1 { top: 20%; left: max(16px, calc(50% - 580px)); width: 52px; height: 52px; }
      .d-d2 { top: 24%; right: max(18px, calc(50% - 580px)); width: 42px; height: 42px; }
      .d-d3 { top: 70%; left: max(22px, calc(50% - 570px)); width: 40px; height: 40px; }
      .d-d4 { top: 72%; right: max(16px, calc(50% - 570px)); width: 46px; height: 46px; }

      /* Philosophy — 6 spaced around the quote, not stacked */
      .d-p1 { top: 12%; left: max(18px, calc(50% - 540px)); width: 40px; height: 40px; }
      .d-p2 { top: 14%; right: max(20px, calc(50% - 540px)); width: 50px; height: 50px; }
      .d-p3 { top: 42%; left: max(12px, calc(50% - 580px)); width: 56px; height: 56px; }
      .d-p4 { top: 44%; right: max(14px, calc(50% - 560px)); width: 62px; height: 62px; }
      .d-p5 { top: 76%; left: max(24px, calc(50% - 540px)); width: 40px; height: 40px; }
      .d-p6 { top: 78%; right: max(18px, calc(50% - 540px)); width: 50px; height: 50px; }
      .d-p7, .d-p8 { display: none; }

      @media (max-width: 1280px) {
        .section-doodles.is-visible .doodle { opacity: 0.75; }
        .d-h1, .d-h3, .d-h5, .d-h7,
        .d-f1, .d-f3, .d-d1, .d-d3, .d-p1, .d-p3, .d-p5 { left: 10px; }
        .d-h2, .d-h4, .d-h6, .d-h8,
        .d-f2, .d-f4, .d-d2, .d-d4, .d-p2, .d-p4, .d-p6 { right: 10px; }
      }
      @media (max-width: 760px) {
        /* Mobile: hide playable layer — washes only (CPU + touch scroll) */
        .section-doodles { display: none; }
        .page-washes .doodle-wash { opacity: 0.18; filter: blur(40px); }
        .doodle-wash-b { display: none; }
      }
      @media (prefers-reduced-motion: reduce) {
        .section-doodles .doodle-wrap {
          transition: none !important;
          animation: none !important;
          opacity: 0.45;
          pointer-events: none;
          cursor: default;
        }
        .section-doodles.is-visible .doodle-wrap { opacity: 0.45; }
      }
      ::selection {
        background: rgba(78, 207, 116, 0.4);
        color: var(--ink);
      }
      .container {
        max-width: 1080px;
        margin: 0 auto;
        padding: 0 24px;
      }
      .rel {
        position: relative;
      }
      code {
        font-family: var(--mono);
        font-size: 0.86em;
        background: var(--surface-2);
        border: 1px solid var(--line);
        border-radius: var(--radius-sm);
        padding: 1px 5px;
        color: var(--text);
      }
      a {
        color: inherit;
      }
      .skip {
        position: absolute;
        left: -9999px;
        top: 0;
        background: var(--ink);
        color: #faf6ec;
        padding: 8px 12px;
        border-radius: var(--radius-md);
        z-index: 100;
      }
      .skip:focus {
        left: 12px;
        top: 12px;
      }

      /* ===== Buttons ===== */
      .btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 6px;
        border-radius: var(--radius-md);
        font-weight: 500;
